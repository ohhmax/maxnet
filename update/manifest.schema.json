{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MAXNET Multi-Model Firmware Manifest Schema",
  "description": "Cryptographically verified, multi-architecture manifest for MAXNET router firmware",
  "type": "object",
  "required": [
    "model_id",
    "board_name",
    "target",
    "soc",
    "hardware_revisions",
    "canonical_sysupgrade",
    "canonical_factory",
    "channels"
  ],
  "properties": {
    "model_id": {
      "type": "string",
      "pattern": "^jidu[0-9a-z]{4}$"
    },
    "display_name": {
      "type": "string"
    },
    "board_name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "target": {
      "type": "string"
    },
    "soc": {
      "type": "string"
    },
    "flash_type": {
      "type": "string",
      "enum": ["nand", "emmc", "nor"]
    },
    "hardware_revisions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "canonical_sysupgrade": {
      "type": "string",
      "pattern": "^maxnet-.*-sysupgrade\\.bin$"
    },
    "canonical_factory": {
      "type": "string"
    },
    "channels": {
      "type": "object",
      "required": ["stable", "staging"],
      "properties": {
        "stable": {
          "$ref": "#/$defs/channel_release"
        },
        "staging": {
          "$ref": "#/$defs/channel_release"
        }
      }
    }
  },
  "$defs": {
    "channel_release": {
      "type": "object",
      "required": [
        "channel",
        "version",
        "build",
        "pushed",
        "release_date",
        "download_url",
        "sha256",
        "size_bytes",
        "min_supported_version",
        "title",
        "description"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "enum": ["stable", "staging"]
        },
        "version": {
          "type": "string"
        },
        "build": {
          "type": "integer",
          "minimum": 0
        },
        "pushed": {
          "type": "boolean"
        },
        "release_date": {
          "type": "string",
          "format": "date"
        },
        "download_url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 10485760
        },
        "min_supported_version": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "signature_url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}