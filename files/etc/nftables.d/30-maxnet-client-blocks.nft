set maxnet_blocked_ips {
    type ipv4_addr;
}

set maxnet_blocked_macs {
    type ether_addr;
}

chain maxnet_client_block_forward {
    type filter hook forward priority -5; policy accept;
    iifname "br-lan" oifname != "br-lan" ip saddr @maxnet_blocked_ips drop comment "maxnet DHCP-client internet block"
    iifname "br-lan" oifname != "br-lan" ether saddr @maxnet_blocked_macs drop comment "maxnet DHCP-client internet block"
}
