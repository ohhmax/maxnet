config usb_wan 'global'
	option mode 'balanced'
	option watchdog '1'
	option ping_target '1.1.1.1'
	option ping_interval '15'
	option dns_override '1.1.1.1 8.8.8.8'
	option auto_reconnect '1'
	option tether_proto 'rndis'

config device 'usb0'
	option name 'USB Modem 1 (Primary)'
	option interface 'usb0'
	option enabled '1'
	option metric '100'
	option weight '50'
	option mtu '1400'

config device 'usb1'
	option name 'USB Modem 2 (Secondary)'
	option interface 'usb1'
	option enabled '1'
	option metric '110'
	option weight '50'
	option mtu '1400'
