config system
	option hostname 'MAXNET'
	option timezone 'IST-5:30'
	option zonename 'Asia/Kolkata'
	option ttylogin '0'
	option log_size '128'
	option urandom_seed '0'
	option zram_size_mb '256'
	option zram_comp_algo 'lzo-rle'

config timeserver 'ntp'
	option enabled '1'
	option enable_server '0'
	list server '0.pool.ntp.org'
	list server '1.pool.ntp.org'
	list server 'time.cloudflare.com'
	list server 'time.google.com'
