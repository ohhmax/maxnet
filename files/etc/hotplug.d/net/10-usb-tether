#!/bin/sh
# Bring up wan_usb automatically and optimize USB 3.0 High-Speed Tethering
case "$DEVICENAME" in
    usb*|ncm*|rndis*) ;;
    *)
        case "$INTERFACE" in
            usb*|ncm*|rndis*) DEVICENAME="$INTERFACE" ;;
            *) exit 0 ;;
        esac
        ;;
esac

if [ "$ACTION" = "add" ]; then
    sleep 1
    ethtool -K "$DEVICENAME" gro on 2>/dev/null || true
    # Multi-Core RPS & RFS Steering (Cores 0-3)
    echo f > "/sys/class/net/$DEVICENAME/queues/rx-0/rps_cpus" 2>/dev/null || true
    echo 4096 > "/sys/class/net/$DEVICENAME/queues/rx-0/rps_flow_cnt" 2>/dev/null || true
    echo f > "/sys/class/net/$DEVICENAME/queues/tx-0/xps_cpus" 2>/dev/null || true

    # Hardware IRQ Steering: Steer xHCI USB 3.0 interrupts to CPU 1
    for irq_dir in /proc/irq/*; do
        if [ -f "$irq_dir/xhci-hcd:usb1" ] || grep -qi "xhci" "$irq_dir/actions" 2>/dev/null; then
            echo 2 > "$irq_dir/smp_affinity" 2>/dev/null || true
        fi
    done

    # Match carrier cellular path MTU (1400/1420) and bounded qlen (1000) to avoid rndis_host NETDEV WATCHDOG TX stalls
    USB_SEC="usb0"
    NET_SEC="wan_usb"
    case "$DEVICENAME" in
        usb[1-5])
            USB_SEC="$DEVICENAME"
            NET_SEC="wan_usb${DEVICENAME#usb}"
            ;;
    esac
    USB_MTU=$(uci -q get "usb_wan.${USB_SEC}.mtu" || uci -q get "network.${NET_SEC}.mtu" || echo 1420)
    [ -z "$USB_MTU" ] && USB_MTU=1420
    ip link set "$DEVICENAME" mtu "$USB_MTU" qlen 1000 2>/dev/null || ifconfig "$DEVICENAME" mtu "$USB_MTU" txqueuelen 1000 2>/dev/null || true

    # Smart Queue Management (CAKE / FQ-CoDel)
    tc qdisc replace dev "$DEVICENAME" root cake diffserv4 ack-filter 2>/dev/null || true

    # Disable USB autosuspend on controller and root hub (control=on only, avoid deprecated power/level)
    for f in /sys/bus/usb/devices/*/power/control; do echo on > "$f" 2>/dev/null; done
    for f in /sys/bus/usb/devices/*/power/autosuspend; do echo -1 > "$f" 2>/dev/null; done

    # Disable USB 3.0 LPM on Samsung Galaxy device
    echo "04e8:6864:k" > /sys/module/usbcore/parameters/quirks 2>/dev/null || true

    # IPv6 Router Solicitation and Neighbor Discovery resilience
    sysctl -w "net.ipv6.conf.$DEVICENAME.accept_ra=2" >/dev/null 2>&1 || true
    sysctl -w "net.ipv6.conf.$DEVICENAME.force_tllao=1" >/dev/null 2>&1 || true
    sysctl -w "net.ipv6.conf.$DEVICENAME.ndisc_notify=1" >/dev/null 2>&1 || true
    ip link set "$DEVICENAME" allmulticast on 2>/dev/null || true

    ifup "$NET_SEC"

    # Wait for gateway IP address assignment and update ADB-Forward redirect only if defined and changed
    (
        for i in $(seq 1 15); do
            sleep 1
            gw=$(ip route show default dev "$DEVICENAME" 2>/dev/null | awk '{print $3}' | head -n 1)
            if [ -n "$gw" ]; then
                if uci -q get firewall.adb_forward >/dev/null 2>&1; then
                    cur_dest=$(uci -q get firewall.adb_forward.dest_ip)
                    if [ "$cur_dest" != "$gw" ]; then
                        uci set firewall.adb_forward.dest_ip="$gw"
                        uci commit firewall
                        /etc/init.d/firewall reload >/dev/null 2>&1
                    fi
                fi
                break
            fi
        done
    ) &
fi
exit 0
