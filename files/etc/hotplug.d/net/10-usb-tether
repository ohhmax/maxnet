#!/bin/sh
# Bring up wan_usb automatically and update firewall DNAT redirect for port 5555
[ "$DEVICENAME" = "usb0" -o "$INTERFACE" = "usb0" ] || exit 0

if [ "$ACTION" = "add" ]; then
    sleep 1
    ethtool -K usb0 gro on 2>/dev/null || true
    # Multi-Core RPS & RFS Steering (Cores 0-3)
    echo f > /sys/class/net/usb0/queues/rx-0/rps_cpus 2>/dev/null || true
    echo 4096 > /sys/class/net/usb0/queues/rx-0/rps_flow_cnt 2>/dev/null || true
    echo f > /sys/class/net/usb0/queues/tx-0/xps_cpus 2>/dev/null || true

    # Hardware IRQ Steering: Steer xHCI USB 3.0 interrupts to CPU 1
    for irq_dir in /proc/irq/*; do
        if [ -f "$irq_dir/xhci-hcd:usb1" ] || grep -qi "xhci" "$irq_dir/actions" 2>/dev/null; then
            echo 2 > "$irq_dir/smp_affinity" 2>/dev/null || true
        fi
    done

    # Maximum Throughput MTU (1500) & Ultra-Deep queue sizing (10000)
    ip link set usb0 mtu 1500 qlen 10000 2>/dev/null || ifconfig usb0 mtu 1500 txqueuelen 10000 2>/dev/null || true

    # Smart Queue Management (CAKE / FQ-CoDel)
    tc qdisc replace dev usb0 root cake diffserv4 ack-filter 2>/dev/null || true

    # Disable USB autosuspend on controller and root hub
    for f in /sys/bus/usb/devices/*/power/control; do echo on > "$f" 2>/dev/null; done
    for f in /sys/bus/usb/devices/*/power/autosuspend; do echo -1 > "$f" 2>/dev/null; done

    # Disable USB 3.0 LPM on Samsung Galaxy device
    echo "04e8:6864:k" > /sys/module/usbcore/parameters/quirks 2>/dev/null || true

    ifup wan_usb
    
    # Wait for gateway IP address assignment and update ADB-Forward redirect
    (
        for i in $(seq 1 15); do
            sleep 1
            gw=$(ip route show default dev usb0 2>/dev/null | awk '{print $3}' | head -n 1)
            if [ -n "$gw" ]; then
                uci set firewall.adb_forward.dest_ip="$gw"
                uci commit firewall
                /etc/init.d/firewall reload >/dev/null 2>&1
                break
            fi
        done
    ) &
fi
exit 0
