#!/bin/sh
[ -e "/lib/firmware/$FIRMWARE" ] && exit 0

. /lib/functions.sh

case "$FIRMWARE" in
"ath11k/IPQ9574/hw1.0/cal-ahb-c000000.wifi"*|"ath11k/IPQ9574/hw1.0/cal-"*)
	mkdir -p /lib/firmware/ath11k/IPQ9574/hw1.0
	art=""
	if command -v find_mtd_chardev >/dev/null 2>&1; then
		art=$(find_mtd_chardev "0:ART")
	fi
	[ -z "$art" ] && [ -c /dev/mtd20ro ] && art="/dev/mtd20ro"
	[ -z "$art" ] && [ -e /dev/mtd20 ] && art="/dev/mtd20"
	if [ -e "$art" ]; then
		dd if=$art of=/lib/firmware/ath11k/IPQ9574/hw1.0/cal-ahb-c000000.wifi.bin bs=4096 skip=1 count=32 2>/dev/null
		[ -f /lib/firmware/ath11k/IPQ9574/hw1.0/cal-ahb-c000000.wifi.bin ] && cp /lib/firmware/ath11k/IPQ9574/hw1.0/cal-ahb-c000000.wifi.bin "/lib/firmware/$FIRMWARE" 2>/dev/null
	fi
	;;
"ath11k/QCN9074/hw1.0/cal-pci-0001:01:00.0"*|"ath11k/QCN9074/hw1.0/cal-"*)
	mkdir -p /lib/firmware/ath11k/QCN9074/hw1.0
	art=""
	if command -v find_mtd_chardev >/dev/null 2>&1; then
		art=$(find_mtd_chardev "0:ART")
	fi
	[ -z "$art" ] && [ -c /dev/mtd20ro ] && art="/dev/mtd20ro"
	[ -z "$art" ] && [ -e /dev/mtd20 ] && art="/dev/mtd20"
	if [ -e "$art" ]; then
		dd if=$art of=/lib/firmware/ath11k/QCN9074/hw1.0/cal-pci-0001:01:00.0.bin bs=4096 skip=76 count=32 2>/dev/null
		[ -f /lib/firmware/ath11k/QCN9074/hw1.0/cal-pci-0001:01:00.0.bin ] && cp /lib/firmware/ath11k/QCN9074/hw1.0/cal-pci-0001:01:00.0.bin "/lib/firmware/$FIRMWARE" 2>/dev/null
	fi
	;;
esac
