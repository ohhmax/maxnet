#!/bin/sh /etc/rc.common
# MAXNET Real-Time WebSocket Telemetry Daemon
USE_PROCD=1
START=96
STOP=10

PROG=/usr/bin/maxnet_wsd

start_service() {
    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall maxnet_wsd 2>/dev/null
}
