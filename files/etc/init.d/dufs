#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

CONF_FILE="/etc/dufs.json"

start_service() {
    ENABLED=false
    if [ -f "$CONF_FILE" ]; then
        ENABLED=$(jq -r '.enabled // false' "$CONF_FILE" 2>/dev/null)
    fi

    [ "$ENABLED" != "true" ] && return 0

    PORT=5000
    PATH_DIR="/mnt/storage"
    FLAGS="-A --enable-cors"
    AUTH=""

    PORT=$(jq -r '.port // 5000' "$CONF_FILE" 2>/dev/null)
    PATH_DIR=$(jq -r '.path // "/mnt/storage"' "$CONF_FILE" 2>/dev/null)
    ALLOW_UPLOAD=$(jq -r '.allow_upload // true' "$CONF_FILE" 2>/dev/null)
    ALLOW_DELETE=$(jq -r '.allow_delete // true' "$CONF_FILE" 2>/dev/null)
    USER=$(jq -r '.user // empty' "$CONF_FILE" 2>/dev/null)
    PASS=$(jq -r '.pass // empty' "$CONF_FILE" 2>/dev/null)

    # Resolve real mounted external USB storage if active
    EXT_MOUNT=$(grep -E '/mnt/(storage/[^ ]+|pendrive|sd[a-z][0-9]*)' /proc/mounts | awk '{print $2}' | head -n 1)
    if [ -n "$EXT_MOUNT" ] && [ -d "$EXT_MOUNT" ]; then
        PATH_DIR="$EXT_MOUNT"
    fi

    [ -z "$USER" ] && [ -n "$PASS" ] && USER="root"

    # No default password required - open/anonymous access unless user/pass configured
    if [ -n "$USER" ] && [ -n "$PASS" ]; then
        if [ "$ALLOW_UPLOAD" = "true" ] && [ "$ALLOW_DELETE" = "true" ]; then
            FLAGS="-A --enable-cors"
            AUTH="-a $USER:$PASS@/:rw"
        elif [ "$ALLOW_UPLOAD" = "true" ]; then
            FLAGS="--enable-cors --allow-upload --allow-search --allow-archive"
            AUTH="-a $USER:$PASS@/:rw"
        else
            FLAGS="--enable-cors --allow-search --allow-archive"
            AUTH="-a $USER:$PASS@/:ro"
        fi
    else
        if [ "$ALLOW_UPLOAD" = "true" ] && [ "$ALLOW_DELETE" = "true" ]; then
            FLAGS="-A --enable-cors"
        elif [ "$ALLOW_UPLOAD" = "true" ]; then
            FLAGS="--enable-cors --allow-upload --allow-search --allow-archive"
        else
            FLAGS="--enable-cors --allow-search --allow-archive"
        fi
        AUTH=""
    fi

    mkdir -p "$PATH_DIR"
    if [ -z "$(ls -A "$PATH_DIR" 2>/dev/null)" ]; then
        cat << 'INFO' > "$PATH_DIR/README_USB_STORAGE.txt"
MAXNET ENTERPRISE ROUTER - USB STORAGE & WEBDAV
================================================
Status: No external USB flash drive or hard drive currently mounted.

To use high-speed network storage:
1. Plug any USB 3.0 Pendrive, Hard Disk, or SSD into the router USB port.
2. The router will automatically mount it and display your files here and over SMB (\\10.0.0.1\Pendrive).
INFO
    fi
    procd_open_instance
    procd_set_param command /usr/bin/dufs "$PATH_DIR"
    procd_append_param command -p "$PORT"
    for f in $FLAGS; do
        procd_append_param command "$f"
    done
    if [ -n "$AUTH" ]; then
        for a in $AUTH; do
            procd_append_param command "$a"
        done
    fi
    if [ -d "/www/dufs-assets" ]; then
        procd_append_param command --assets /www/dufs-assets
    fi
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
