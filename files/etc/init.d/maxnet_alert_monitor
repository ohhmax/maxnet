#!/bin/sh /etc/rc.common
# MAXNET OS 24/7 Alert Monitor Service

START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /usr/bin/maxnet_alert_monitor.sh
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
