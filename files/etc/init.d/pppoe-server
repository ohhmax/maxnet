#!/bin/sh /etc/rc.common
START=90
STOP=10
USE_PROCD=1

CONF_SERVER="/etc/pppoe-server.json"
OPTIONS_FILE="/etc/ppp/pppoe-server-options"

start_service() {
    [ ! -f "$CONF_SERVER" ] && return 0
    ENABLED=$(jq -r '.server_enabled // false' "$CONF_SERVER" 2>/dev/null)
    [ "$ENABLED" != "true" ] && return 0

    IFACE=$(jq -r '.listen_iface // "br-lan"' "$CONF_SERVER" 2>/dev/null)
    L_IP=$(jq -r '.server_ip // "10.0.0.1"' "$CONF_SERVER" 2>/dev/null)
    P_START=$(jq -r '.pool_start // "10.0.0.150"' "$CONF_SERVER" 2>/dev/null)
    MAX_SESS=$(jq -r '.max_sessions // 32' "$CONF_SERVER" 2>/dev/null)
    SERV_NAME=$(jq -r '.service_name // "MAXNET"' "$CONF_SERVER" 2>/dev/null)

    procd_open_instance
    procd_set_param command /usr/sbin/pppoe-server -I "$IFACE" -L "$L_IP" -R "$P_START" -N "$MAX_SESS" -C "$SERV_NAME" -S "$SERV_NAME" -k
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall -9 pppoe-server >/dev/null 2>&1
}
