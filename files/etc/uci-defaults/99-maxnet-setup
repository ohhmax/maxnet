#!/bin/sh

# Remove default root password for passwordless system login only on clean/factory installs
root_hash=$(awk -F: '$1=="root"{print $2}' /etc/shadow 2>/dev/null)
case "$root_hash" in
	""|"\*"|"\!"|"x")
		passwd -d root 2>/dev/null || true
		;;
	*)
		# User has a configured root password; preserve it across sysupgrades
		;;
esac

# Set system hostname and timezone (preserve user hostname if already customized)
cur_host=$(uci -q get system.@system[0].hostname)
if [ -z "$cur_host" ] || [ "$cur_host" = "OpenWrt" ]; then
	uci set system.@system[0].hostname="MAXNET"
fi
uci set system.@system[0].zonename="Asia/Kolkata"
uci set system.@system[0].timezone="IST-5:30"
uci set system.@system[0].zram_size_mb="256"
uci set system.@system[0].zram_comp_algo="lzo-rle"
uci commit system

# Configure LAN IP to 10.0.0.1 and secondary alias 10.0.0.254 (preserve user IP if customized)
cur_lan=$(uci -q get network.lan.ipaddr)
if [ -z "$cur_lan" ] || [ "$cur_lan" = "192.168.1.1" ]; then
	uci set network.lan.ipaddr="10.0.0.1"
	uci add_list network.lan.ipaddr="10.0.0.254/24" 2>/dev/null || true
fi
uci set network.@globals[0].packet_steering="2"
uci set network.@globals[0].steering_flows="4096"
uci commit network

# Ensure board-native wireless config exists before applying MAXNET SSID defaults (works across Qualcomm & MediaTek)
if [ ! -s /etc/config/wireless ]; then
	wifi config 2>/dev/null || true
fi

# Set Default High-Performance Wi-Fi SSIDs & Balanced Tx-Power ONLY if unconfigured or default OpenWrt
for radio in $(uci -q show wireless | sed -n 's/^wireless\.\(radio[0-9]*\)=wifi-device$/\1/p'); do
	band=$(uci -q get "wireless.${radio}.band")
	iface="default_${radio}"
	cur_ssid=$(uci -q get "wireless.${iface}.ssid")
	if [ -z "$cur_ssid" ] || [ "$cur_ssid" = "OpenWrt" ]; then
		if [ "$band" = "5g" ]; then
			uci set "wireless.${iface}.ssid=MAXNET-5G" 2>/dev/null || true
		else
			uci set "wireless.${iface}.ssid=MAXNET" 2>/dev/null || true
		fi
		uci set "wireless.${iface}.encryption=none" 2>/dev/null || true
		uci delete "wireless.${iface}.key" 2>/dev/null || true
	fi
	if [ -z "$(uci -q get "wireless.${radio}.txpower")" ]; then
		[ "$band" = "5g" ] && uci set "wireless.${radio}.txpower=23" 2>/dev/null || uci set "wireless.${radio}.txpower=20" 2>/dev/null || true
	fi
done
uci commit wireless 2>/dev/null || true

# Fix dnsmasq startup sequence (START=60 after S20network)
rm -f /etc/rc.d/S19dnsmasq 2>/dev/null || true
[ -x /etc/init.d/dnsmasq ] && ln -sf ../init.d/dnsmasq /etc/rc.d/S60dnsmasq 2>/dev/null || true

# Setup U-Boot fw_env.config for OpenWrt APPSBLENV
. /lib/functions.sh
mtdnum=$(find_mtd_index 0:APPSBLENV)
[ -n "$mtdnum" ] && echo "/dev/mtd$mtdnum 0x0 0x40000 0x20000" > /etc/fw_env.config

# Restrict Dropbear SSH exclusively to LAN interface
uci set dropbear.@dropbear[0].Interface="lan"
uci commit dropbear

# Add USB Tethering interface (wan_usb) for mobile internet
if ! uci get network.wan_usb >/dev/null 2>&1; then
	uci set network.wan_usb=interface
	uci set network.wan_usb.proto="dhcp"
	uci set network.wan_usb.device="usb0"
	uci set network.wan_usb.mtu="1420"
	uci commit network
else
	uci set network.wan_usb.mtu="1420"
	uci commit network
fi

# Ensure wan_usb is part of the wan firewall zone (idempotent, no duplicates)
if uci get firewall.@zone[1] >/dev/null 2>&1; then
	if ! uci -q get firewall.@zone[1].network | grep -qw "wan_usb"; then
		uci add_list firewall.@zone[1].network="wan_usb" 2>/dev/null || true
		uci commit firewall
	fi
fi

# Ensure adb is the native ELF binary (never wrap in shell script to prevent daemon ACK failure)
if [ -f /usr/bin/adb.real ]; then
	mv -f /usr/bin/adb.real /usr/bin/adb
	chmod 755 /usr/bin/adb
fi
rm -f /usr/bin/adb-wrapper

# Enable USB Tethering Watchdog Service
[ -x /etc/init.d/usb_tether_watchdog ] && /etc/init.d/usb_tether_watchdog enable && /etc/init.d/usb_tether_watchdog start

# Enable LED Internet Lifecycle Monitor Service if present
[ -x /etc/init.d/led_internet_monitor ] && /etc/init.d/led_internet_monitor enable && /etc/init.d/led_internet_monitor start

# Generate per-device TLS certificate and key if absent
if [ ! -s /etc/uhttpd.key ] || [ ! -s /etc/uhttpd.crt ]; then
	if command -v uhttpd-gencert >/dev/null 2>&1; then
		uhttpd-gencert -d 3650 -D MAXNET -L "MAXNET Router"
	elif command -v openssl >/dev/null 2>&1; then
		openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
			-keyout /etc/uhttpd.key -out /etc/uhttpd.crt \
			-subj "/C=IN/ST=GJ/L=MAXNET/O=MAXNET Enterprise/CN=10.0.0.1" 2>/dev/null || true
	fi
	chmod 600 /etc/uhttpd.key 2>/dev/null || true
	chmod 644 /etc/uhttpd.crt 2>/dev/null || true
fi

# Generate per-device Android ADB key if absent or invalid
mkdir -p /root/.android
chmod 700 /root/.android 2>/dev/null || true
if [ ! -s /root/.android/adbkey ] || ! grep -q 'BEGIN.*PRIVATE KEY' /root/.android/adbkey 2>/dev/null; then
	rm -f /root/.android/adbkey /root/.android/adbkey.pub
	export HOME=/root
	export ADB_VENDOR_KEYS=/root/.android
	if [ -x /usr/bin/adb.real ]; then
		/usr/bin/adb.real start-server >/dev/null 2>&1 || true
		/usr/bin/adb.real kill-server >/dev/null 2>&1 || true
	elif command -v adb >/dev/null 2>&1; then
		adb start-server >/dev/null 2>&1 || true
		adb kill-server >/dev/null 2>&1 || true
	fi
	chmod 600 /root/.android/adbkey 2>/dev/null || true
	chmod 644 /root/.android/adbkey.pub 2>/dev/null || true
fi

# Enable uhttpd web monitor on port 80
[ -x /etc/init.d/uhttpd ] && /etc/init.d/uhttpd enable && /etc/init.d/uhttpd restart

# Ensure executable bits on MAXNET daemons, hotplug hooks, and CGI handlers
chmod +x /etc/init.d/maxnet* /etc/hotplug.d/net/* /etc/hotplug.d/dhcp/* /etc/hotplug.d/iface/* 2>/dev/null || true

# Enable MAXNET Core Background Daemons & Services (On-demand SMB/Storage, Zero Idle Bloat)
for s in trafficd maxnet_devices maxnet_storage multilinkd maxnet_alert_monitor maxnet_health_watchdog maxnet_wsd phone_telemetry ttyd; do
	[ -x "/etc/init.d/$s" ] && /etc/init.d/"$s" enable 2>/dev/null && /etc/init.d/"$s" start 2>/dev/null || true
done

# Generate baseline topology map if missing
if [ ! -s /etc/topology_layers.json ] && [ -x /usr/bin/topology_auto_detect.sh ]; then
	( /usr/bin/topology_auto_detect.sh > /etc/topology_layers.json.tmp 2>/dev/null && [ -s /etc/topology_layers.json.tmp ] && mv -f /etc/topology_layers.json.tmp /etc/topology_layers.json ) &
fi
# Conserve DDR4 RAM by default on clean factory install, but preserve if already enabled
if [ "$(uci -q get samba4.@samba[0].enabled)" = "1" ] || [ -f /etc/rc.d/S*samba4 ]; then
	[ -x /etc/init.d/samba4 ] && /etc/init.d/samba4 enable 2>/dev/null || true
elif [ ! -f /sysupgrade.tgz ]; then
	[ -x /etc/init.d/samba4 ] && /etc/init.d/samba4 disable 2>/dev/null || true
fi
if [ -s /etc/tailscale/tailscaled.state ]; then
	[ -x /etc/init.d/tailscale ] && /etc/init.d/tailscale enable 2>/dev/null && /etc/init.d/tailscale start 2>/dev/null || true
else
	[ -x /etc/init.d/tailscale ] && /etc/init.d/tailscale disable 2>/dev/null || true
fi
[ -x /etc/init.d/dbus ] && /etc/init.d/dbus disable 2>/dev/null || true
[ -x /etc/init.d/avahi-daemon ] && /etc/init.d/avahi-daemon disable 2>/dev/null || true

exit 0
