# 5Gbps Multi-Core RPS & High-Performance Network Tuning (MAXNET Optimized)
sysctl -w net.core.rps_sock_flow_entries=4096
sysctl -w net.core.netdev_max_backlog=4096
sysctl -w net.core.rmem_max=4194304
sysctl -w net.core.wmem_max=4194304
sysctl -w net.ipv4.tcp_rmem="4096 131072 4194304"
sysctl -w net.ipv4.tcp_wmem="4096 16384 4194304"

# Apply LAN reliability & L4 multipath routing
sysctl -p /etc/sysctl.d/99-lan-reliability.conf 2>/dev/null || true
[ -d /sys/class/net/br-lan/bridge ] && echo 0 > /sys/class/net/br-lan/bridge/multicast_snooping 2>/dev/null || true

# Multi-Core RPS Steering across all 4 A73 cores (Mask 0xF = 1111b)
for q in /sys/class/net/*/queues/rx-*; do
    [ -f "$q/rps_cpus" ] && echo f > "$q/rps_cpus" 2>/dev/null
    [ -f "$q/rps_flow_cnt" ] && echo 4096 > "$q/rps_flow_cnt" 2>/dev/null
done

# Hardware IRQ Steering: Offload USB 3.0 xHCI controller to CPU 1 (Mask 0x2)
for irq_dir in /proc/irq/*; do
    if [ -f "$irq_dir/xhci-hcd:usb1" ] || grep -qi "xhci" "$irq_dir/actions" 2>/dev/null; then
        echo 2 > "$irq_dir/smp_affinity" 2>/dev/null || true
    fi
done

# MAXNET Multicore Wi-Fi IRQ Steering: Distribute txcmpl and ath11k rings across CPU 1, 2, 3
for irq in $(awk -F: '/txcmpl/ {print $1}' /proc/interrupts 2>/dev/null); do
    irq=$(echo "$irq" | tr -d ' ')
    if [ -f "/proc/irq/$irq/smp_affinity" ]; then
        cpu=$(( (irq % 3) + 1 ))
        mask=$(printf '%x' $((1 << cpu)))
        echo "$mask" > "/proc/irq/$irq/smp_affinity" 2>/dev/null || true
    fi
done

# Protect essential control-plane and administrative services (uhttpd, dropbear, netifd, hostapd)
(
    sleep 5
    for p in procd ubusd netifd dnsmasq hostapd wpa_supplicant odhcpd uhttpd dropbear; do
        for pid in $(pidof "$p" 2>/dev/null); do
            echo -1000 > "/proc/$pid/oom_score_adj" 2>/dev/null || true
        done
    done
    # Optional background services
    for p in tailscaled smbd dufs; do
        for pid in $(pidof "$p" 2>/dev/null); do
            echo 200 > "/proc/$pid/oom_score_adj" 2>/dev/null || true
        done
    done
) &

# Storage drivers and pendrive auto-mount
insmod /lib/modules/6.18.60/usb-storage.ko 2>/dev/null
insmod /lib/modules/6.18.60/fuse.ko 2>/dev/null

exit 0
