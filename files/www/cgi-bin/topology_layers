#!/bin/sh
echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo "Access-Control-Allow-Methods: GET, POST, OPTIONS"
echo "Access-Control-Allow-Headers: Content-Type"
echo ""

CONF_FILE="/etc/topology_layers.json"

# Clean Default configuration with ZERO mock devices
init_default() {
  LAN_IP=$(uci get network.lan.ipaddr 2>/dev/null || echo "10.0.0.1")
  LAN_MAC=$(cat /sys/class/net/br-lan/address 2>/dev/null || cat /sys/class/net/eth0/address 2>/dev/null || echo "52:5a:4e:e9:61:a0")
  HOST_NAME=$(cat /proc/sys/kernel/hostname 2>/dev/null || echo "MAXNET")
  cat << EOF
{
  "status": "ok",
  "version": 2,
  "tree": {
    "id": "root",
    "type": "router",
    "name": "${HOST_NAME}",
    "ip": "${LAN_IP}",
    "mac": "${LAN_MAC}",
    "uplinkPort": null,
    "numPorts": 4,
    "wan_mode": "standard",
    "wan_speed": "1000",
    "usb_config": {
      "mode": "hub",
      "num_ports": 4,
      "speed_std": "usb3",
      "ports": [
        { "id": "usb-1", "label": "USB 1", "role": "empty", "name": "", "speed": "usb3" },
        { "id": "usb-2", "label": "USB 2", "role": "empty", "name": "", "speed": "usb3" },
        { "id": "usb-3", "label": "USB 3", "role": "empty", "name": "", "speed": "usb3" },
        { "id": "usb-4", "label": "USB 4", "role": "empty", "name": "", "speed": "usb3" }
      ]
    },
    "ports": [
      { "id": "root-lan1", "label": "LAN 1", "role": "empty", "child": null },
      { "id": "root-lan2", "label": "LAN 2", "role": "empty", "child": null },
      { "id": "root-lan3", "label": "LAN 3", "role": "empty", "child": null },
      { "id": "root-lan4", "label": "LAN 4", "role": "empty", "child": null }
    ],
    "wireless_clients": []
  },
  "ports": {
    "lan1": { "portIndex": 1, "mode": "empty", "device": null },
    "lan2": { "portIndex": 2, "mode": "empty", "device": null },
    "lan3": { "portIndex": 3, "mode": "empty", "device": null },
    "lan4": { "portIndex": 4, "mode": "empty", "device": null }
  }
}
EOF
}

if [ "$REQUEST_METHOD" = "POST" ]; then
  POST_DATA=$(cat)
  if [ -n "$POST_DATA" ]; then
    echo "$POST_DATA" | jq . > "$CONF_FILE" 2>/dev/null
    if [ $? -eq 0 ]; then
      sync
      echo '{"status":"ok","message":"Topology layer configuration saved successfully"}'
      exit 0
    fi
  fi
fi

# Check query params for action=save, reset, or auto_scan
QS="$QUERY_STRING"
case "$QS" in
  *action=reset*)
    init_default > "$CONF_FILE"
    sync
    cat "$CONF_FILE"
    exit 0
    ;;
  *action=auto_scan*|*action=auto*)
    STATUS_JSON=$(QUERY_STRING="action=status" /www/cgi-bin/status 2>/dev/null | sed '1,/^$/d')
    AUTO_TREE=$(echo "$STATUS_JSON" | jq '
      .clients as $all
      | ($all | map(select(.is_self != true and .connected == true))) as $active
      | ($active | map(select(.port == "LAN 1"))) as $lan1_devs
      | ($active | map(select(.port == "LAN 2"))) as $lan2_devs
      | ($active | map(select(.port == "LAN 3"))) as $lan3_devs
      | ($active | map(select(.port == "LAN 4"))) as $lan4_devs
      | ($active | map(select(.port == "WiFi" or ((.conn_type // "") | contains("WiFi")) or .is_wifi == true or (.port != "LAN 1" and .port != "LAN 2" and .port != "LAN 3" and .port != "LAN 4")))) as $wifi_devs
      | {
          status: "ok",
          version: 2,
          tree: {
            id: "root",
            type: "router",
            name: "MAXNET",
            ip: ((.network.lan_ip // "10.0.0.1") | split(" ")[0] | split("/")[0]),
            mac: (.network.lan_mac // "52:5a:4e:e9:61:a0"),
            uplinkPort: null,
            numPorts: 4,
            wan_mode: "standard",
            wan_speed: "1000",
            usb_config: {
              mode: "hub",
              num_ports: 4,
              speed_std: "usb3",
              ports: [
                { id: "usb-1", label: "USB 1", role: (if (.usb_devices | length) > 0 then "device" else "empty" end), name: (if (.usb_devices | length) > 0 then .usb_devices[0].product else "" end), speed: "usb3" },
                { id: "usb-2", label: "USB 2", role: "empty", name: "", speed: "usb3" },
                { id: "usb-3", label: "USB 3", role: "empty", name: "", speed: "usb3" },
                { id: "usb-4", label: "USB 4", role: "empty", name: "", speed: "usb3" }
              ]
            },
            ports: [
              {
                id: "root-lan1",
                label: "LAN 1",
                role: (if ($lan1_devs | length) > 0 then "device" else "empty" end),
                child: (if ($lan1_devs | length) > 0 then {
                  id: ("dev-" + ($lan1_devs[0].mac | split(":") | join(""))),
                  type: "device",
                  name: $lan1_devs[0].name,
                  ip: $lan1_devs[0].ip,
                  mac: $lan1_devs[0].mac,
                  status: "online",
                  uplinkPort: "root-lan1"
                } else null end)
              },
              {
                id: "root-lan2",
                label: "LAN 2",
                role: (if ($lan2_devs | length) > 0 then "device" else "empty" end),
                child: (if ($lan2_devs | length) > 0 then {
                  id: ("dev-" + ($lan2_devs[0].mac | split(":") | join(""))),
                  type: "device",
                  name: $lan2_devs[0].name,
                  ip: $lan2_devs[0].ip,
                  mac: $lan2_devs[0].mac,
                  status: "online",
                  uplinkPort: "root-lan2"
                } else null end)
              },
              {
                id: "root-lan3",
                label: "LAN 3",
                role: (if ($lan3_devs | length) > 0 then "device" else "empty" end),
                child: (if ($lan3_devs | length) > 0 then {
                  id: ("dev-" + ($lan3_devs[0].mac | split(":") | join(""))),
                  type: "device",
                  name: $lan3_devs[0].name,
                  ip: $lan3_devs[0].ip,
                  mac: $lan3_devs[0].mac,
                  status: "online",
                  uplinkPort: "root-lan3"
                } else null end)
              },
              {
                id: "root-lan4",
                label: "LAN 4",
                role: (if ($lan4_devs | length) > 0 then "device" else "empty" end),
                child: (if ($lan4_devs | length) > 0 then {
                  id: ("dev-" + ($lan4_devs[0].mac | split(":") | join(""))),
                  type: "device",
                  name: $lan4_devs[0].name,
                  ip: $lan4_devs[0].ip,
                  mac: $lan4_devs[0].mac,
                  status: "online",
                  uplinkPort: "root-lan4"
                } else null end)
              }
            ],
            wireless_clients: [
              $wifi_devs[] | {
                name: .name,
                ip: .ip,
                mac: .mac,
                status: "online",
                band: (.band // "WiFi"),
                linkSpeed: (.link_speed // "144 Mbps")
              }
            ]
          }
        }
    ' 2>/dev/null)
    if [ -n "$AUTO_TREE" ] && echo "$AUTO_TREE" | jq -e '.tree' >/dev/null 2>&1; then
      echo "$AUTO_TREE" > "$CONF_FILE"
      sync
      echo "$AUTO_TREE"
      exit 0
    fi
    init_default > "$CONF_FILE"
    sync
    cat "$CONF_FILE"
    exit 0
    ;;
  *action=save*)
    DATA=$(echo "$QS" | sed -n 's/.*data=\([^&]*\).*/\1/p')
    if [ -n "$DATA" ]; then
      DECODED=$(printf '%b' "${DATA//%/\\x}")
      echo "$DECODED" | jq . > "$CONF_FILE" 2>/dev/null
      if [ $? -eq 0 ]; then
        sync
        echo '{"status":"ok","message":"Topology layer configuration saved successfully"}'
        exit 0
      fi
    fi
    ;;
esac

if [ -f "$CONF_FILE" ] && [ -s "$CONF_FILE" ]; then
  cat "$CONF_FILE"
else
  init_default | tee "$CONF_FILE"
  sync
fi
