#!/bin/sh
# Require administrator authentication
. /www/cgi-bin/lib/auth_check.sh 2>/dev/null || . "$(dirname "$0")/lib/auth_check.sh" 2>/dev/null || exit 1
require_auth

echo "Content-Type: application/json"
echo "Cache-Control: no-cache, no-store, must-revalidate"
echo "Pragma: no-cache"
echo "Expires: 0"
echo "Access-Control-Allow-Methods: GET, POST, OPTIONS"
echo "Access-Control-Allow-Headers: Content-Type"
echo ""

CONF_FILE="/etc/topology_layers.json"

# Clean Default configuration with ZERO mock devices
init_default() {
  LAN_IP=$(uci get network.lan.ipaddr 2>/dev/null || echo "10.0.0.1")
  LAN_MAC=$(cat /sys/class/net/br-lan/address 2>/dev/null || cat /sys/class/net/eth0/address 2>/dev/null || echo "52:5a:4e:e9:61:a0")
  HOST_NAME=$(cat /proc/sys/kernel/hostname 2>/dev/null || echo "MAXNET")
  cat << EOF
{
  "status": "ok",
  "version": 2,
  "tree": {
    "id": "root",
    "type": "router",
    "name": "${HOST_NAME}",
    "ip": "${LAN_IP}",
    "mac": "${LAN_MAC}",
    "uplinkPort": null,
    "active_uplink": { "device": "", "interface": "", "mode": "disconnected", "speed_mbps": 0, "connected": false, "gateway": "" },
    "repeater_uplink": { "connected": false, "ssid": "" },
    "numPorts": 4,
    "wan_mode": "disconnected",
    "wan_speed": "unknown",
    "usb_config": {
      "mode": "hub",
      "num_ports": 0,
      "speed_std": "usb3",
      "ports": []
    },
    "ports": [
      { "id": "root-lan1", "label": "LAN 1", "role": "empty", "child": null },
      { "id": "root-lan2", "label": "LAN 2", "role": "empty", "child": null },
      { "id": "root-lan3", "label": "LAN 3", "role": "empty", "child": null },
      { "id": "root-lan4", "label": "LAN 4", "role": "empty", "child": null }
    ],
    "wireless_clients": []
  },
  "ports": {
    "lan1": { "portIndex": 1, "mode": "empty", "device": null },
    "lan2": { "portIndex": 2, "mode": "empty", "device": null },
    "lan3": { "portIndex": 3, "mode": "empty", "device": null },
    "lan4": { "portIndex": 4, "mode": "empty", "device": null }
  }
}
EOF
}

if [ "$REQUEST_METHOD" = "POST" ]; then
  [ -z "$POST_DATA" ] && POST_DATA=$(cat)
  if [ -n "$POST_DATA" ]; then
    printf '%s\n' "$POST_DATA" | jq . > "$CONF_FILE" 2>/dev/null
    if [ $? -eq 0 ]; then
      sync
      echo '{"status":"ok","message":"Topology layer configuration saved successfully"}'
      exit 0
    fi
  fi
fi

# Check query params for action=save, reset, or auto_scan
QS="$QUERY_STRING"
case "$QS" in
  *action=reset*)
    init_default > "$CONF_FILE"
    sync
    ;;
  *action=auto_scan*|*action=auto*)
    if [ -x /usr/bin/topology_auto_detect.sh ]; then
      AUTO_TREE=$(/usr/bin/topology_auto_detect.sh 2>/dev/null)
      if [ -n "$AUTO_TREE" ] && echo "$AUTO_TREE" | jq -e '.tree' >/dev/null 2>&1; then
        echo "$AUTO_TREE" > "$CONF_FILE"
        sync
        echo "$AUTO_TREE"
        exit 0
      fi
    fi
    init_default > "$CONF_FILE"
    sync
    cat "$CONF_FILE"
    exit 0
    ;;
  *action=save*)
    DATA=$(echo "$QS" | sed -n 's/.*data=\([^&]*\).*/\1/p')
    if [ -n "$DATA" ]; then
      DECODED=$(printf '%b' "${DATA//%/\\x}")
      echo "$DECODED" | jq . > "$CONF_FILE" 2>/dev/null
      if [ $? -eq 0 ]; then
        sync
        echo '{"status":"ok","message":"Topology layer configuration saved successfully"}'
        exit 0
      fi
    fi
    ;;
esac

if [ -f "$CONF_FILE" ] && [ -s "$CONF_FILE" ]; then
  SAVED=$(cat "$CONF_FILE")
else
  SAVED=$(init_default)
  printf '%s\n' "$SAVED" > "$CONF_FILE"
  sync
fi
STATUS_JSON=$(HTTP_COOKIE="${HTTP_COOKIE:-}" HTTP_AUTHORIZATION="${HTTP_AUTHORIZATION:-}" HTTP_X_SESSION_TOKEN="${HTTP_X_SESSION_TOKEN:-}" HTTP_ACCEPT_ENCODING= QUERY_STRING="action=status&token=${CURRENT_AUTH_TOKEN:-}" /www/cgi-bin/status 2>/dev/null | sed '1,/^$/d')
DYNAMIC_TREE=
if [ -n "$STATUS_JSON" ]; then
  DYNAMIC_TREE=$(printf '%s' "$SAVED" | jq --argjson status "$STATUS_JSON" '
    .tree.active_uplink = ($status.network.uplink // {device:"",interface:"",mode:"disconnected",speed_mbps:0,connected:false,gateway:""})
    | .tree.wan_speed = (if (($status.network.uplink.speed_mbps // 0) | tonumber) > 0 then ($status.network.uplink.speed_mbps | tostring) else "unknown" end)
    | .tree.uplinkPort = (if ($status.network.uplink.connected // false) then $status.network.uplink.device else null end)
    | .tree.repeater_uplink = (if $status.network.uplink.mode == "repeater" then ($status.repeater // {connected:false,ssid:""}) else {connected:false,ssid:""} end)
  ' 2>/dev/null)
fi
if [ -n "$DYNAMIC_TREE" ]; then
  printf '%s\n' "$DYNAMIC_TREE"
else
  printf '%s' "$SAVED" | jq '
    .tree.active_uplink = {device:"",interface:"",mode:"disconnected",speed_mbps:0,connected:false,gateway:""}
    | .tree.wan_speed = "unknown"
    | .tree.uplinkPort = null
    | .tree.repeater_uplink = {connected:false,ssid:""}
  ' 2>/dev/null || init_default
fi
