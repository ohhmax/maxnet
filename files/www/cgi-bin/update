#!/bin/sh
# ==============================================================================
# MAXNET UNIVERSAL MULTI-DEVICE OTA FIRMWARE ENGINE
# Automated board-specific firmware resolution, verification & sysupgrade
# Supports all Jio router models: JIDU6811, JIDU6911, JIDU6611, JIDU6411, JIDU6111,
# JIDU6801, JIDU6401, JIDU6601, JIDU6701, JIDU6101, JIDU6J01
# ==============================================================================
# Require administrator authentication
. /www/cgi-bin/lib/auth_check.sh 2>/dev/null || . "$(dirname "$0")/lib/auth_check.sh" 2>/dev/null || exit 1
require_auth

echo "Content-Type: application/json"
echo "Cache-Control: no-cache, no-store, must-revalidate"
echo ""

ACTION="$1"
[ -n "$ACTION" ] && echo "$ACTION" | grep -q '=' && ACTION=$(echo "$ACTION" | sed -n 's/^.*action=\([^&]*\).*$/\1/p')
[ -z "$ACTION" ] && ACTION=$(echo "$QUERY_STRING" | sed -n 's/^.*action=\([^&]*\).*$/\1/p')

# Fast path: Status & Progress Queries (Instant return, zero network delay)
if [ "$ACTION" = "status" ] || [ "$ACTION" = "progress" ]; then
    if [ -f /tmp/ota_status.json ]; then
        cat /tmp/ota_status.json
    else
        echo '{"state":"idle","progress":0,"message":"No update task active"}'
    fi
    exit 0
fi

# Auto-update toggle handler
if [ "$ACTION" = "set_auto_update" ]; then
    AUTO_UPD=$(echo "$QUERY_STRING" | sed -n 's/^.*enabled=\([^&]*\).*$/\1/p')
    [ "$AUTO_UPD" != "0" ] && [ "$AUTO_UPD" != "false" ] && AUTO_UPD="1" || AUTO_UPD="0"
    echo "$AUTO_UPD" > /etc/maxnet_auto_update
    echo "{\"status\": \"ok\", \"auto_update\": $AUTO_UPD, \"message\": \"Auto-update preference saved\"}"
    exit 0
fi

# Channel switching handler
if [ "$ACTION" = "set_channel" ]; then
    REQ_BODY=""
    [ "$REQUEST_METHOD" = "POST" ] && [ "$CONTENT_LENGTH" -gt 0 ] 2>/dev/null && read -n "$CONTENT_LENGTH" REQ_BODY
    NEW_CHAN=$(echo "$QUERY_STRING" | sed -n 's/^.*channel=\([^&]*\).*$/\1/p')
    [ -z "$NEW_CHAN" ] && [ -n "$REQ_BODY" ] && NEW_CHAN=$(echo "$REQ_BODY" | jq -r '.channel // empty' 2>/dev/null)
    if [ "$NEW_CHAN" != "stable" ] && [ "$NEW_CHAN" != "staging" ]; then
        echo '{"status": "error", "message": "Invalid channel. Allowed: stable, staging"}'
        exit 0
    fi
    echo "$NEW_CHAN" > /etc/maxnet_ota_channel
    rm -f /tmp/updates.json
    echo "{\"status\": \"ok\", \"channel\": \"$NEW_CHAN\", \"message\": \"Firmware update channel switched to $NEW_CHAN\"}"
    exit 0
fi

# Resolve active channel (staging is strictly isolated unless explicitly opted-in)
ACTIVE_CHANNEL=$(echo "$QUERY_STRING" | sed -n 's/^.*channel=\([^&]*\).*$/\1/p')
[ -z "$ACTIVE_CHANNEL" ] && [ -f /etc/maxnet_ota_channel ] && ACTIVE_CHANNEL=$(cat /etc/maxnet_ota_channel 2>/dev/null | tr -d '\r\n ')
[ "$ACTIVE_CHANNEL" != "staging" ] && ACTIVE_CHANNEL="stable"

BOARD_NAME=$(cat /tmp/sysinfo/board_name 2>/dev/null || tr '\0' '\n' < /proc/device-tree/compatible 2>/dev/null | head -n 1)
MODEL_NAME=$(cat /tmp/sysinfo/model 2>/dev/null || cat /proc/device-tree/model 2>/dev/null | tr -d '\0' || echo "JioRouter AX6000")
HW_REV=$(cat /tmp/sysinfo/board_revision 2>/dev/null || echo "default")

CURRENT_BUILD=""
CURRENT_VER=""

if [ -f /etc/maxnet_version ]; then
    CURRENT_VER=$(grep '^VERSION=' /etc/maxnet_version 2>/dev/null | cut -d'=' -f2 | tr -d '"'\')
    CURRENT_BUILD=$(grep '^BUILD=' /etc/maxnet_version 2>/dev/null | cut -d'=' -f2 | tr -d '"'\')
fi

if [ -z "$CURRENT_VER" ]; then
    CURRENT_VER=$(grep -o 'v2\.[0-9.]*' /etc/banner 2>/dev/null | head -n 1)
fi

if [ -z "$CURRENT_BUILD" ]; then
    CURRENT_BUILD=$(grep -o '#[0-9]*' /etc/banner 2>/dev/null | tr -d '#' | head -n 1)
fi

# Fallback for initial legacy installs that lack the version stamp
[ -z "$CURRENT_VER" ] && CURRENT_VER="v2.2.0"
[ -z "$CURRENT_BUILD" ] && CURRENT_BUILD=0

# Resolve router model key strictly from hardware board_name
DEV_KEY=""
case "$BOARD_NAME" in
    *6911*) DEV_KEY="jidu6911" ;;
    *6811*) DEV_KEY="jidu6811" ;;
    *6611*) DEV_KEY="jidu6611" ;;
    *6411*) DEV_KEY="jidu6411" ;;
    *6111*) DEV_KEY="jidu6111" ;;
    *6401*) DEV_KEY="jidu6401" ;;
    *6801*) DEV_KEY="jidu6801" ;;
    *6601*) DEV_KEY="jidu6601" ;;
    *6701*) DEV_KEY="jidu6701" ;;
    *6101*) DEV_KEY="jidu6101" ;;
    *6j01*) DEV_KEY="jidu6j01" ;;
    *) DEV_KEY="unknown" ;;
esac

# ==================== VERIFIED UPDATE MANIFEST PIPELINE ====================
# Model-wise JSON manifest: updates/<model>.json
UPDATES_URL="https://raw.githubusercontent.com/ohhmax/maxnet/main/updates/${DEV_KEY}.json"
UPDATES_FILE="/tmp/update_${DEV_KEY}.json"

# ==================== ACTION: MANUAL FIRMWARE UPLOAD & FLASH ====================
if [ "$ACTION" = "upload" ] || [ "$ACTION" = "upload_bin" ]; then
    UPLOAD_DEST="/tmp/sysupgrade_manual.bin"
    KEEP_CFG=$(echo "$QUERY_STRING" | sed -n 's/^.*keep=\([^&]*\).*$/\1/p')
    [ -z "$KEEP_CFG" ] && KEEP_CFG="1"

    # Stream the raw payload from standard input directly to /tmp
    cat > "$UPLOAD_DEST"

    if [ ! -s "$UPLOAD_DEST" ]; then
        echo '{"status": "error", "message": "Uploaded firmware file is empty."}'
        exit 0
    fi

    # 1. Structural check: OpenWrt FIT header magic (0xd00dfeed) or sysupgrade test
    MAGIC=$(hexdump -n 4 -e '1/1 "%02x"' "$UPLOAD_DEST" 2>/dev/null)
    if [ "$MAGIC" != "d00dfeed" ] && ! sysupgrade -T "$UPLOAD_DEST" >/dev/null 2>&1; then
        rm -f "$UPLOAD_DEST"
        echo '{"status": "error", "message": "Invalid firmware: Magic byte 0xd00dfeed check failed. File is not a valid MAXNET sysupgrade binary."}'
        exit 0
    fi

    CALC_SUM=$(sha256sum "$UPLOAD_DEST" 2>/dev/null | awk '{print $1}')
    FILE_SZ=$(wc -c < "$UPLOAD_DEST" 2>/dev/null | tr -d ' \r\n')
    [ -z "$FILE_SZ" ] && FILE_SZ=0

    # 2. Write initial status for progress poller
    rm -f /tmp/ota_status.json
    cat << EOF > /tmp/ota_status.json
{"state":"flashing","progress":70,"message":"Writing verified manual firmware to flash memory..."}
EOF

    # 3. Trigger sysupgrade asynchronously
    (
        sleep 2
        logger -t maxnet_ota "Manual sysupgrade starting (keep=$KEEP_CFG, size=$FILE_SZ, sha256=$CALC_SUM)..."
        if [ "$KEEP_CFG" = "0" ] || [ "$KEEP_CFG" = "clean" ] || [ "$KEEP_CFG" = "false" ]; then
            sysupgrade -n "$UPLOAD_DEST" >/dev/null 2>&1
        else
            sysupgrade "$UPLOAD_DEST" >/dev/null 2>&1
        fi
    ) >/dev/null 2>&1 &

    echo "{\"status\": \"started\", \"message\": \"Firmware verified successfully. Flashing initiated in background.\", \"sha256\": \"$CALC_SUM\", \"size\": $FILE_SZ, \"action\": \"manual_upload\"}"
    exit 0
fi

# Refresh model update json if missing or older than 180s
FETCH_NOW=1
if [ -s "$UPDATES_FILE" ] && jq -e . "$UPDATES_FILE" >/dev/null 2>&1; then
    FILE_TIME=$(date -r "$UPDATES_FILE" +%s 2>/dev/null || stat -c %Y "$UPDATES_FILE" 2>/dev/null || echo 0)
    [ -z "$FILE_TIME" ] && FILE_TIME=0
    AGE=$(( $(date +%s) - FILE_TIME ))
    [ "$AGE" -lt 180 ] && FETCH_NOW=0
fi

if [ "$FETCH_NOW" -eq 1 ]; then
    TMP_FILE="${UPDATES_FILE}.$$.tmp"
    curl -s -L --connect-timeout 4 --max-time 8 -o "$TMP_FILE" "$UPDATES_URL" 2>/dev/null
    if [ -s "$TMP_FILE" ] && jq -e . "$TMP_FILE" >/dev/null 2>&1; then
        mv -f "$TMP_FILE" "$UPDATES_FILE" 2>/dev/null
    else
        rm -f "$TMP_FILE" 2>/dev/null
        # Local fallback if present
        if [ ! -s "$UPDATES_FILE" ] || ! jq -e . "$UPDATES_FILE" >/dev/null 2>&1; then
            [ -s "/etc/updates/${DEV_KEY}.json" ] && cp "/etc/updates/${DEV_KEY}.json" "$UPDATES_FILE" 2>/dev/null
            [ -s "/www/updates/${DEV_KEY}.json" ] && cp "/www/updates/${DEV_KEY}.json" "$UPDATES_FILE" 2>/dev/null
        fi
    fi
fi

IS_PUSHED=false
LATEST_VER=""
LATEST_BUILD=0
BIN_URL=""
EXPECTED_SUM=""
FILE_SIZE=0
UPDATE_TITLE=""
UPDATE_DESC=""
SIG_URL=""
MIN_VER="2.2.0"
TARGET_ARCH=""
TARGET_SOC=""

# Model-wise JSON: find the latest version where .tested == true
if [ -s "$UPDATES_FILE" ] && command -v jq >/dev/null 2>&1; then
    LATEST_ENTRY=$(jq -c '[.versions[]? | select(.tested == true)] | sort_by(.build) | last // empty' "$UPDATES_FILE" 2>/dev/null)
    if [ -n "$LATEST_ENTRY" ]; then
        IS_PUSHED=true
        LATEST_VER=$(echo "$LATEST_ENTRY" | jq -r '.version // empty')
        LATEST_BUILD=$(echo "$LATEST_ENTRY" | jq -r '.build // 0')
        BIN_URL=$(echo "$LATEST_ENTRY" | jq -r '.url // empty')
        EXPECTED_SUM=$(echo "$LATEST_ENTRY" | jq -r '.sha256 // empty')
        FILE_SIZE=$(echo "$LATEST_ENTRY" | jq -r '.size // .size_bytes // 31457280')
        UPDATE_TITLE=$(echo "$LATEST_ENTRY" | jq -r '.title // empty')
        UPDATE_DESC=$(echo "$LATEST_ENTRY" | jq -r '.description // empty')
        [ -z "$UPDATE_TITLE" ] && UPDATE_TITLE="MAXNET | V${LATEST_VER}"
        [ -z "$UPDATE_DESC" ] && UPDATE_DESC="N/A"
    fi
fi

RESOLVED_FILE="maxnet-${DEV_KEY}-sysupgrade.bin"
[ -n "$BIN_URL" ] && RESOLVED_FILE=$(basename "$BIN_URL")

# Handle Background Asynchronous Flash Execution
if [ "$ACTION" = "flash" ] || [ "$ACTION" = "flash_clean" ]; then
    if [ -z "$BIN_URL" ] || [ -z "$EXPECTED_SUM" ]; then
        echo '{"status": "error", "message": "No verified update URL or SHA256 checksum found in manifest for this hardware model"}'
        exit 0
    fi
    rm -f /tmp/ota_status.json
    /usr/bin/maxnet_ota_worker.sh "$ACTION" "$BIN_URL" "$EXPECTED_SUM" "$FILE_SIZE" "$LATEST_VER" "$LATEST_BUILD" "$SIG_URL" "$MIN_VER" "$DEV_KEY" </dev/null >/dev/null 2>&1 &
    echo "{\"status\": \"started\", \"action\": \"$ACTION\", \"target\": \"$RESOLVED_FILE\", \"latest\": \"$LATEST_VER\", \"channel\": \"$ACTIVE_CHANNEL\", \"message\": \"Verified firmware upgrade started in background\"}"
    exit 0
fi

# Query Update Availability Status
IS_UPDATE_AVAIL=0
if [ "$IS_PUSHED" = "true" ] && [ "$LATEST_BUILD" -gt "$CURRENT_BUILD" ]; then
    IS_UPDATE_AVAIL=1
fi

STATUS_STR="up_to_date"
[ "$IS_UPDATE_AVAIL" -eq 1 ] && STATUS_STR="update_available"

AUTO_UPDATE=1
[ -f /etc/maxnet_auto_update ] && [ "$(cat /etc/maxnet_auto_update 2>/dev/null | tr -d ' \r\n')" = "0" ] && AUTO_UPDATE=0

jq -n \
    --arg status "$STATUS_STR" \
    --argjson is_update "$IS_UPDATE_AVAIL" \
    --argjson auto_update "$AUTO_UPDATE" \
    --arg channel "$ACTIVE_CHANNEL" \
    --arg current "$CURRENT_VER" \
    --arg latest "$LATEST_VER" \
    --argjson latest_build "$LATEST_BUILD" \
    --argjson current_build "$CURRENT_BUILD" \
    --arg board "$BOARD_NAME" \
    --arg model "$MODEL_NAME" \
    --arg model_id "$DEV_KEY" \
    --arg target_arch "$TARGET_ARCH" \
    --arg target_soc "$TARGET_SOC" \
    --arg hw_rev "$HW_REV" \
    --arg file "$RESOLVED_FILE" \
    --arg url "$BIN_URL" \
    --arg sha256 "$EXPECTED_SUM" \
    --arg sig_url "$SIG_URL" \
    --arg min_ver "$MIN_VER" \
    --argjson size "$FILE_SIZE" \
    --arg title "$UPDATE_TITLE" \
    --arg description "$UPDATE_DESC" \
    '{
        status: $status,
        is_update: $is_update,
        auto_update: ($auto_update == 1),
        channel: $channel,
        current: $current,
        latest: $latest,
        latest_build: $latest_build,
        current_build: $current_build,
        board: $board,
        model: $model,
        model_id: $model_id,
        target_arch: $target_arch,
        target_soc: $target_soc,
        hw_rev: $hw_rev,
        file: $file,
        url: $url,
        sha256: $sha256,
        signature_url: $sig_url,
        min_supported_version: $min_ver,
        size: $size,
        title: $title,
        description: $description,
        signature_verified: ($sig_url != ""),
        anti_rollback_ok: ($latest_build >= $current_build),
        signature_warning: ""
    }'
exit 0
