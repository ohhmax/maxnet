PRIV_KEY="/etc/maxnet_auth_priv.pem"
PUB_KEY="/etc/maxnet_auth_pub.pem"
NONCE_DIR="/tmp/auth_nonces"
SESS_DIR="/tmp/sessions"
LOGIN_ATTEMPTS_DIR="/tmp/login_attempts"
PERSIST_LOCKOUT_DIR="/etc/login_lockouts"

mkdir -p "$SESS_DIR" "$NONCE_DIR" "$LOGIN_ATTEMPTS_DIR" "$PERSIST_LOCKOUT_DIR" 2>/dev/null
chmod 700 "$SESS_DIR" "$NONCE_DIR" "$LOGIN_ATTEMPTS_DIR" "$PERSIST_LOCKOUT_DIR" 2>/dev/null

check_ip_rate_limit() {
    local ip_clean ip_tmp ip_persist fail_count lock_time remain
    ip_clean=$(echo "$CLIENT_IP" | tr -c 'a-zA-Z0-9.' '_')
    ip_tmp="$LOGIN_ATTEMPTS_DIR/$ip_clean"
    ip_persist="$PERSIST_LOCKOUT_DIR/$ip_clean"

    if [ ! -f "$ip_tmp" ] && [ -f "$ip_persist" ]; then
        cp -f "$ip_persist" "$ip_tmp" 2>/dev/null
    fi

    if [ -f "$ip_tmp" ]; then
        fail_count=$(awk 'NR==1{print $1}' "$ip_tmp" 2>/dev/null || echo 0)
        lock_time=$(awk 'NR==1{print $2}' "$ip_tmp" 2>/dev/null || echo 0)
        if [ "$fail_count" -ge 5 ]; then
            remain=$((lock_time + 900 - NOW))
            if [ "$remain" -gt 0 ]; then
                send_json_str "{\"status\": \"error\", \"message\": \"Security Lockout: Too many failed login attempts. Retry in ${remain} seconds.\"}"
                exit 0
            else
                rm -f "$ip_tmp" "$ip_persist" 2>/dev/null
            fi
        fi
    fi
}

record_ip_failure() {
    local ip_clean ip_tmp ip_persist fail_count attempts_left
    ip_clean=$(echo "$CLIENT_IP" | tr -c 'a-zA-Z0-9.' '_')
    ip_tmp="$LOGIN_ATTEMPTS_DIR/$ip_clean"
    ip_persist="$PERSIST_LOCKOUT_DIR/$ip_clean"

    fail_count=0
    if [ -f "$ip_tmp" ]; then
        fail_count=$(awk 'NR==1{print $1}' "$ip_tmp" 2>/dev/null || echo 0)
    fi
    fail_count=$((fail_count + 1))
    # Cap ceiling to prevent unbounded growth
    [ "$fail_count" -gt 100 ] && fail_count=100

    # Housekeeping: prune old entries if record count exceeds ceiling (50 records)
    if [ $(ls -1 "$LOGIN_ATTEMPTS_DIR" 2>/dev/null | wc -l) -gt 50 ]; then
        find "$LOGIN_ATTEMPTS_DIR" -type f -mmin +60 -delete 2>/dev/null || true
    fi
    if [ $(ls -1 "$PERSIST_LOCKOUT_DIR" 2>/dev/null | wc -l) -gt 50 ]; then
        find "$PERSIST_LOCKOUT_DIR" -type f -mmin +1440 -delete 2>/dev/null || true
    fi

    echo "$fail_count $NOW" > "$ip_tmp"
    if [ "$fail_count" -ge 5 ]; then
        echo "$fail_count $NOW" > "$ip_persist" 2>/dev/null
    fi

    attempts_left=$((5 - fail_count))
    if [ "$attempts_left" -le 0 ]; then
        dispatch_login_alert "Security Lockout: Brute-Force Blocked" "IP $CLIENT_IP locked out for 15 minutes after 5 consecutive failed WebUI login attempts." "danger" "security_alert"
        send_json_str '{"status": "error", "message": "Security Lockout: Too many failed login attempts. Account locked for 15 minutes."}'
    else
        dispatch_login_alert "Failed Router Login Attempt" "Failed WebUI login attempt for user '$USER' from IP $CLIENT_IP ($attempts_left attempts remaining)." "warning" "router_login"
        send_json_str "{\"status\": \"error\", \"message\": \"Invalid username or password. ${attempts_left} attempts remaining before temporary lockout.\"}"
    fi
    exit 0
}

clear_ip_failure() {
    local ip_clean
    ip_clean=$(echo "$CLIENT_IP" | tr -c 'a-zA-Z0-9.' '_')
    rm -f "$LOGIN_ATTEMPTS_DIR/$ip_clean" "$PERSIST_LOCKOUT_DIR/$ip_clean" 2>/dev/null
}

[ "$REQUEST_METHOD" = "POST" ] && [ -n "$CONTENT_LENGTH" ] && POST_DATA=$(head -c "$CONTENT_LENGTH" 2>/dev/null)

# Extract params
ACTION=$(echo "$QUERY_STRING" | sed -n 's/^.*action=\([^&]*\).*$/\1/p')
[ -z "$ACTION" ] && [ -n "$POST_DATA" ] && ACTION=$(echo "$POST_DATA" | jq -r '.action // empty' 2>/dev/null)
[ -z "$ACTION" ] && [ -n "$POST_DATA" ] && ACTION=$(echo "$POST_DATA" | sed -n 's/.*"action"[ ]*:[ ]*"\([^"]*\)".*/\1/p')

USER="root"
if [ -n "$POST_DATA" ]; then
    _U=$(echo "$POST_DATA" | jq -r '.user // empty' 2>/dev/null)
    [ -n "$_U" ] && USER="$_U"
fi

OLD_PASS=""
NEW_PASS=""
if [ -n "$POST_DATA" ]; then
    OLD_PASS=$(echo "$POST_DATA" | jq -r '.old_pass // empty' 2>/dev/null)
    NEW_PASS=$(echo "$POST_DATA" | jq -r '.new_pass // empty' 2>/dev/null)
fi

TOKEN=""
# 1. From Authorization header
if [ -n "${HTTP_AUTHORIZATION:-}" ]; then
    TOKEN=$(printf "%s" "$HTTP_AUTHORIZATION" | sed -e 's/^[bB][eE][aA][rR][eE][rR][ ]*//' -e 's/[ ]*$//')
fi
# 2. From X-Session-Token header
[ -z "$TOKEN" ] && [ -n "${HTTP_X_SESSION_TOKEN:-}" ] && TOKEN="$HTTP_X_SESSION_TOKEN"
# 3. From POST body
if [ -z "$TOKEN" ] && [ -n "$POST_DATA" ]; then
    TOKEN=$(echo "$POST_DATA" | jq -r '.token // empty' 2>/dev/null)
    [ -z "$TOKEN" ] && TOKEN=$(echo "$POST_DATA" | sed -n 's/.*"token"[ ]*:[ ]*"\([^"]*\)".*/\1/p')
fi
# 4. From query string
[ -z "$TOKEN" ] && TOKEN=$(echo "$QUERY_STRING" | sed -n 's/^.*token=\([^&]*\).*$/\1/p')

TARGET_TOKEN=""
if [ -n "$POST_DATA" ]; then
    TARGET_TOKEN=$(echo "$POST_DATA" | jq -r '.target_token // empty' 2>/dev/null)
fi
[ -z "$TARGET_TOKEN" ] && TARGET_TOKEN=$(echo "$QUERY_STRING" | sed -n 's/^.*target_token=\([^&]*\).*$/\1/p')

# Strict Token Whitelist Function: exactly 32 hex characters
is_valid_token() {
    [ -n "$1" ] && printf "%s" "$1" | grep -Eq '^[a-f0-9]{32}$'
}

# Blank out invalid token inputs to prevent path traversal
if [ -n "$TOKEN" ] && ! is_valid_token "$TOKEN"; then
    TOKEN=""
fi
if [ -n "$TARGET_TOKEN" ] && ! is_valid_token "$TARGET_TOKEN"; then
    TARGET_TOKEN=""
fi

CLIENT_IP="${REMOTE_ADDR:-127.0.0.1}"
UA="${HTTP_USER_AGENT:-Web Browser}"
NOW=$(date +%s)

# Response Compression & Delivery (Same-Origin Only, No Wildcard CORS)
send_json_str() {
    if echo "${HTTP_ACCEPT_ENCODING:-}" | grep -qi "gzip"; then
        printf "Content-Type: application/json\r\n"
        printf "Content-Encoding: gzip\r\n"
        printf "Cache-Control: no-cache, no-store, must-revalidate\r\n\r\n"
        printf "%s\n" "$1" | gzip -c -1
    else
        printf "Content-Type: application/json\r\n"
        printf "Cache-Control: no-cache, no-store, must-revalidate\r\n\r\n"
        printf "%s\n" "$1"
    fi
}

ensure_auth_keys() {
    if [ ! -f "$PRIV_KEY" ] || [ ! -f "$PUB_KEY" ]; then
        mkdir -p /etc
        openssl genpkey -algorithm RSA -out "$PRIV_KEY" -pkeyopt rsa_keygen_bits:2048 2>/dev/null
        chmod 600 "$PRIV_KEY"
        openssl rsa -in "$PRIV_KEY" -pubout -out "$PUB_KEY" 2>/dev/null
        chmod 644 "$PUB_KEY"
    fi
}

dispatch_login_alert() {
    _title="$1"
    _msg="$2"
    _level="$3"
    _ev_type="$4"
    if [ -x "/www/cgi-bin/webhooks" ]; then
        payload=$(jq -n --arg t "$_title" --arg m "$_msg" --arg l "$_level" --arg et "$_ev_type" \
            '{action:"dispatch", title:$t, message:$m, level:$l, event_type:$et}')
        POST_DATA="$payload" REQUEST_METHOD="POST" CONTENT_LENGTH=${#payload} /www/cgi-bin/webhooks >/dev/null 2>&1 &
    fi
}

# Session Verification Helper
require_valid_session() {
    if [ -z "$TOKEN" ] || ! is_valid_token "$TOKEN" || [ ! -f "$SESS_DIR/$TOKEN" ] || [ ! -s "$SESS_DIR/$TOKEN" ]; then
        send_json_str '{"status": "unauthorized", "authenticated": false, "message": "Valid administrator session required"}'
        exit 0
    fi

    # Check idle timeout (1800s = 30m)
    _last=$(jq -r '.last_active // .created // 0' "$SESS_DIR/$TOKEN" 2>/dev/null)
    [ -z "$_last" ] && _last=0
    _idle=$((NOW - _last))
    if [ "$_idle" -gt 1800 ] || [ "$_idle" -lt 0 ]; then
        rm -f "$SESS_DIR/$TOKEN"
        send_json_str '{"status": "unauthorized", "authenticated": false, "message": "Session expired due to inactivity"}'
        exit 0
    fi

    # Refresh last_active
    _tmp="$SESS_DIR/.tmp_$TOKEN"
    jq --argjson now "$NOW" '.last_active = $now' "$SESS_DIR/$TOKEN" > "$_tmp" 2>/dev/null && mv -f "$_tmp" "$SESS_DIR/$TOKEN"
}

# ==================== ACTION: CHALLENGE / PUBLIC_KEY ====================
if [ "$ACTION" = "challenge" ] || [ "$ACTION" = "public_key" ]; then
    ensure_auth_keys
    find "$NONCE_DIR" -type f -mmin +5 -delete 2>/dev/null
    NONCE=$(head -c 16 /dev/urandom | hexdump -ve '1/1 "%02x"')
    touch "$NONCE_DIR/$NONCE"

    PUB_KEY_JSON=$(jq -Rs . "$PUB_KEY" 2>/dev/null)
    RESP=$(jq -n \
        --arg status "ok" \
        --arg nonce "$NONCE" \
        --arg ts "$NOW" \
        --argjson pubkey "$PUB_KEY_JSON" \
        '{status: $status, nonce: $nonce, timestamp: ($ts | tonumber), public_key: $pubkey}')
    send_json_str "$RESP"
    exit 0
fi

# ==================== ACTION: LOGIN_ENCRYPTED ====================
if [ "$ACTION" = "login_encrypted" ]; then
    check_ip_rate_limit

    ENC_PAYLOAD=$(echo "$POST_DATA" | jq -r '.payload // empty' 2>/dev/null)
    NONCE=$(echo "$POST_DATA" | jq -r '.nonce // empty' 2>/dev/null)

    if [ -z "$ENC_PAYLOAD" ] || [ -z "$NONCE" ]; then
        send_json_str '{"status": "error", "message": "Missing encrypted payload or challenge nonce"}'
        exit 0
    fi

    # Verify and immediately consume nonce
    if [ ! -f "$NONCE_DIR/$NONCE" ]; then
        send_json_str '{"status": "error", "message": "Challenge nonce expired or replayed. Please retry login."}'
        exit 0
    fi
    rm -f "$NONCE_DIR/$NONCE"

    ensure_auth_keys
    DECRYPTED_JSON=$(printf "%s" "$ENC_PAYLOAD" | base64 -d 2>/dev/null | openssl pkeyutl -decrypt -inkey "$PRIV_KEY" -pkeyopt rsa_padding_mode:oaep -pkeyopt rsa_oaep_md:sha256 2>/dev/null)

    if [ -z "$DECRYPTED_JSON" ]; then
        send_json_str '{"status": "error", "message": "Cryptographic payload decryption failed"}'
        exit 0
    fi

    USER=$(echo "$DECRYPTED_JSON" | jq -r '.user // empty' 2>/dev/null)
    PASS=$(echo "$DECRYPTED_JSON" | jq -r '.pass // empty' 2>/dev/null)
    [ -z "$USER" ] && USER="root"

    ROOT_SHADOW=$(awk -F: '$1=="root"{print $2}' /etc/shadow 2>/dev/null)
    AUTH_OK=0
    if [ -z "$ROOT_SHADOW" ] || [ "$ROOT_SHADOW" = "*" ] || [ "$ROOT_SHADOW" = "!" ]; then
        # When no password has been configured in /etc/shadow, empty password allows login
        [ -z "$PASS" ] && AUTH_OK=1
    elif [ -n "$PASS" ] && /usr/bin/checkpass "$USER" "$PASS" >/dev/null 2>&1; then
        AUTH_OK=1
    fi

    if [ "$AUTH_OK" -eq 1 ]; then
        clear_ip_failure
        T=$(head -c 16 /dev/urandom | md5sum | awk '{print $1}')
        cat << SESS > "$SESS_DIR/$T"
{
  "token": "$T",
  "user": "$USER",
  "ip": "$CLIENT_IP",
  "ua": "$UA",
  "created": $NOW,
  "last_active": $NOW,
  "encrypted": true
}
SESS
        chmod 600 "$SESS_DIR/$T"
        dispatch_login_alert "Router WebUI Login: $USER" "Administrator '$USER' logged into MAXNET Gateway WebUI via RSA-OAEP encrypted session from IP $CLIENT_IP." "info" "router_login"
        send_json_str "{\"status\": \"ok\", \"token\": \"$T\", \"user\": \"$USER\", \"ip\": \"$CLIENT_IP\", \"encrypted\": true}"
    else
        record_ip_failure
    fi
    exit 0
fi

# ==================== ACTION: LOGIN (LEGACY - PERMANENTLY DISABLED) ====================
if [ "$ACTION" = "login" ]; then
    send_json_str '{"status": "error", "message": "Plain-text login endpoint is permanently disabled. Use encrypted authentication."}'
    exit 0
fi

# ==================== ACTION: VERIFY ====================
if [ "$ACTION" = "verify" ]; then
    if [ -n "$TOKEN" ] && is_valid_token "$TOKEN" && [ -f "$SESS_DIR/$TOKEN" ]; then
        _last=$(jq -r '.last_active // .created // 0' "$SESS_DIR/$TOKEN" 2>/dev/null)
        [ -z "$_last" ] && _last=0
        _idle=$((NOW - _last))
        if [ "$_idle" -gt 1800 ] || [ "$_idle" -lt 0 ]; then
            rm -f "$SESS_DIR/$TOKEN"
            send_json_str '{"status": "unauthorized", "authenticated": false, "message": "Session expired due to inactivity"}'
        else
            _tmp="$SESS_DIR/.tmp_$TOKEN"
            jq --argjson now "$NOW" '.last_active = $now' "$SESS_DIR/$TOKEN" > "$_tmp" 2>/dev/null && mv -f "$_tmp" "$SESS_DIR/$TOKEN"
            send_json_str '{"status": "ok", "authenticated": true}'
        fi
    else
        send_json_str '{"status": "unauthorized", "authenticated": false}'
    fi
    exit 0
fi

# ==================== ACTION: LIST_SESSIONS ====================
if [ "$ACTION" = "list_sessions" ]; then
    require_valid_session

    SESSIONS_JSON=""
    for sf in "$SESS_DIR"/*; do
        [ ! -f "$sf" ] && continue
        bname=$(basename "$sf")
        # Ensure only valid 32-hex token files are listed
        if ! is_valid_token "$bname"; then
            continue
        fi

        if [ -s "$sf" ] && grep -q '"token"' "$sf" 2>/dev/null; then
            s_ip=$(jq -r '.ip // "127.0.0.1"' "$sf" 2>/dev/null)
            s_user=$(jq -r '.user // "root"' "$sf" 2>/dev/null)
            s_ua=$(jq -r '.ua // "Web Browser"' "$sf" 2>/dev/null)
            s_created=$(jq -r '.created // 0' "$sf" 2>/dev/null)
            s_last=$(jq -r '.last_active // 0' "$sf" 2>/dev/null)
        else
            continue
        fi

        is_curr="false"
        [ "$bname" = "$TOKEN" ] && is_curr="true"

        s_ua_clean=$(echo "$s_ua" | tr '"\\' '  ' | cut -c 1-255)
        SESSIONS_JSON="${SESSIONS_JSON}{\"token\": \"$bname\", \"user\": \"$s_user\", \"ip\": \"$s_ip\", \"ua\": \"$s_ua_clean\", \"created\": $s_created, \"last_active\": $s_last, \"is_current\": $is_curr},"
    done

    SESSIONS_JSON=$(echo "$SESSIONS_JSON" | sed 's/,$//')
    RESP=$(jq -n \
        --arg status "ok" \
        --arg current_ip "$CLIENT_IP" \
        --arg current_token "$TOKEN" \
        --argjson sessions "[$SESSIONS_JSON]" \
        '{status: $status, current_ip: $current_ip, current_token: $current_token, sessions: $sessions}' 2>/dev/null)
    
    if [ -n "$RESP" ]; then
        send_json_str "$RESP"
    else
        send_json_str "{\"status\": \"ok\", \"current_ip\": \"$CLIENT_IP\", \"current_token\": \"$TOKEN\", \"sessions\": [${SESSIONS_JSON}]}"
    fi
    exit 0
fi

# ==================== ACTION: LOGOUT_DEVICE ====================
if [ "$ACTION" = "logout_device" ]; then
    require_valid_session
    if is_valid_token "$TARGET_TOKEN"; then
        rm -f "$SESS_DIR/$TARGET_TOKEN"
        send_json_str '{"status": "ok", "message": "Device session terminated"}'
    else
        send_json_str '{"status": "error", "message": "Invalid or missing target token"}'
    fi
    exit 0
fi

# ==================== ACTION: LOGOUT_OTHERS ====================
if [ "$ACTION" = "logout_others" ]; then
    require_valid_session
    for sf in "$SESS_DIR"/*; do
        [ ! -f "$sf" ] && continue
        bname=$(basename "$sf")
        [ "$bname" != "$TOKEN" ] && is_valid_token "$bname" && rm -f "$sf"
    done
    send_json_str '{"status": "ok", "message": "All other sessions terminated"}'
    exit 0
fi

# ==================== ACTION: LOGOUT_ALL ====================
if [ "$ACTION" = "logout_all" ]; then
    require_valid_session
    for sf in "$SESS_DIR"/*; do
        [ -f "$sf" ] && is_valid_token "$(basename "$sf")" && rm -f "$sf"
    done
    send_json_str '{"status": "ok", "message": "All sessions terminated"}'
    exit 0
fi

# ==================== ACTION: LOGOUT ====================
if [ "$ACTION" = "logout" ]; then
    if is_valid_token "$TOKEN"; then
        rm -f "$SESS_DIR/$TOKEN"
    fi
    send_json_str '{"status": "ok"}'
    exit 0
fi

# ==================== ACTION: CHECK_ROOT_PASS ====================
if [ "$ACTION" = "check_root_pass" ] || [ "$ACTION" = "has_password" ]; then
    CURRENT_HASH=$(awk -F: -v u="${USER:-root}" '$1==u {print $2}' /etc/shadow 2>/dev/null)
    HAS_PASSWORD=false
    if [ -n "$CURRENT_HASH" ] && [ "$CURRENT_HASH" != "*" ] && [ "$CURRENT_HASH" != "!" ] && [ ${#CURRENT_HASH} -gt 5 ]; then
        HAS_PASSWORD=true
    fi
    send_json_str "{\"status\": \"ok\", \"has_password\": $HAS_PASSWORD}"
    exit 0
fi

# ==================== ACTION: CHANGE_PASSWORD ====================
if [ "$ACTION" = "change_password" ]; then
    CURRENT_HASH=$(awk -F: -v u="${USER:-root}" '$1==u {print $2}' /etc/shadow 2>/dev/null)
    HAS_PASSWORD=false
    if [ -n "$CURRENT_HASH" ] && [ "$CURRENT_HASH" != "*" ] && [ "$CURRENT_HASH" != "!" ] && [ ${#CURRENT_HASH} -gt 5 ]; then
        HAS_PASSWORD=true
    fi

    # Minimum length requirement: at least 8 characters
    if [ -z "$NEW_PASS" ] || [ "${#NEW_PASS}" -lt 8 ]; then
        send_json_str '{"status": "error", "message": "New password must be at least 8 characters long"}'
        exit 0
    fi

    # When password already exists, require valid session and old password verification
    if [ "$HAS_PASSWORD" = "true" ]; then
        require_valid_session
        check_ip_rate_limit
        if [ -z "$OLD_PASS" ]; then
            send_json_str '{"status": "error", "message": "Current password is required"}'
            exit 0
        fi
        if ! /usr/bin/checkpass "$USER" "$OLD_PASS" >/dev/null 2>&1; then
            record_ip_failure
        fi
        clear_ip_failure
    fi

    printf "%s\n%s\n" "$NEW_PASS" "$NEW_PASS" | passwd "$USER" >/dev/null 2>&1
    if [ $? -eq 0 ]; then
        send_json_str '{"status": "ok", "message": "Password updated successfully for SSH and WebUI"}'
    else
        send_json_str '{"status": "error", "message": "Failed to update system password"}'
    fi
    exit 0
fi

send_json_str '{"status": "error", "message": "Unknown action"}'
exit 0
