#!/bin/sh
echo "Content-Type: application/json"
echo "Cache-Control: no-cache, no-store, must-revalidate"
echo "Access-Control-Allow-Origin: *"
echo ""

# Router CPU temperature
R_TEMP_RAW=$(cat /sys/class/thermal/thermal_zone7/temp 2>/dev/null || cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
R_TEMP_C=$(awk -v t="${R_TEMP_RAW:-45000}" 'BEGIN {printf "%.1f", t/1000}')

# Router RAM (Physical + ZRAM Combined Pool)
MEM_PHYS_TOTAL=$(awk '/MemTotal:/ {print $2}' /proc/meminfo)
MEM_PHYS_AVAIL=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo)
SWAP_TOTAL=$(awk '/SwapTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
SWAP_FREE=$(awk '/SwapFree:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)

MEM_TOTAL=$(( MEM_PHYS_TOTAL + SWAP_TOTAL ))
MEM_AVAIL=$(( MEM_PHYS_AVAIL + SWAP_FREE ))
MEM_USED=$(( MEM_TOTAL - MEM_AVAIL ))
MEM_PCT=0
[ "$MEM_TOTAL" -gt 0 ] && MEM_PCT=$(( MEM_USED * 100 / MEM_TOTAL ))

# Router Uptime
UP_SEC=$(awk '{print int($1)}' /proc/uptime 2>/dev/null)
UP_H=$(( UP_SEC / 3600 ))
UP_M=$(( (UP_SEC % 3600) / 60 ))
UPTIME_FMT="${UP_H}h ${UP_M}m"

# Samsung Telemetry Cache
SAM_CPU_TEMP=37.3
SAM_BAT_TEMP=34.1
SAM_BAT_LVL=79
SAM_BAT_STAT="Paused"
if [ -f /tmp/phone_telemetry.json ]; then
    s_cpu=$(jq -r '.cpu.temp_c // empty' /tmp/phone_telemetry.json 2>/dev/null)
    [ -n "$s_cpu" ] && SAM_CPU_TEMP="$s_cpu"
    s_bt=$(jq -r '.battery.temp_c // empty' /tmp/phone_telemetry.json 2>/dev/null)
    [ -n "$s_bt" ] && SAM_BAT_TEMP="$s_bt"
    s_bl=$(jq -r '.battery.level // empty' /tmp/phone_telemetry.json 2>/dev/null)
    [ -n "$s_bl" ] && SAM_BAT_LVL="$s_bl"
    s_bs=$(jq -r '.battery.status // empty' /tmp/phone_telemetry.json 2>/dev/null)
    [ -n "$s_bs" ] && SAM_BAT_STAT="$s_bs"
fi

# OPPO Telemetry Cache
OPP_TEMP=29.2
OPP_BAT_LVL=100
OPP_BAT_STAT="Trickle (100%)"

MAX_TEMP="$R_TEMP_C"
awk -v m="$MAX_TEMP" -v c="$SAM_CPU_TEMP" 'BEGIN{if(c>m) exit 0; exit 1}' && MAX_TEMP="$SAM_CPU_TEMP"

OVERALL_HEALTH="GOOD"
OVERALL_SCORE=98
if awk -v t="$MAX_TEMP" 'BEGIN{if(t > 70.0) exit 0; exit 1}'; then
    OVERALL_HEALTH="CRITICAL"
    OVERALL_SCORE=60
elif awk -v t="$MAX_TEMP" 'BEGIN{if(t > 55.0) exit 0; exit 1}'; then
    OVERALL_HEALTH="WARNING"
    OVERALL_SCORE=80
fi

TS=$(date '+%Y-%m-%d %H:%M:%S')
R_HOSTNAME=$(uci get system.@system[0].hostname 2>/dev/null || cat /proc/sys/kernel/hostname 2>/dev/null || echo "Maxnet-Gateway")

cat << JSON
{
  "status": "ok",
  "hostname": "${R_HOSTNAME}",
  "overall_health": "${OVERALL_HEALTH}",
  "health_score": ${OVERALL_SCORE},
  "timestamp": "${TS}",
  "router": {
    "hostname": "${R_HOSTNAME}",
    "model": "Qualcomm IPQ9574 AX6000",
    "cpu_temp_c": ${R_TEMP_C},
    "ram_pct": ${MEM_PCT},
    "uptime": "${UPTIME_FMT}",
    "status": "Optimal"
  },
  "devices": [
    {
      "name": "Samsung Galaxy S21 FE 5G",
      "serial": "RZCW6090G4J",
      "port": 2,
      "virtual_ip": "10.0.0.202",
      "hostname": "usb2-Galaxy-S21-FE-5G.lan",
      "standard": "USB 3.0 SuperSpeed",
      "cpu_temp_c": ${SAM_CPU_TEMP},
      "battery_temp_c": ${SAM_BAT_TEMP},
      "battery_pct": ${SAM_BAT_LVL},
      "battery_status": "${SAM_BAT_STAT}",
      "health": "Optimal"
    },
    {
      "name": "OPPO A37",
      "serial": "4e1c1cf",
      "port": 4,
      "virtual_ip": "10.0.0.204",
      "hostname": "usb4-A37.lan",
      "standard": "USB 2.0 HighSpeed",
      "cpu_temp_c": ${OPP_TEMP},
      "battery_temp_c": ${OPP_TEMP},
      "battery_pct": ${OPP_BAT_LVL},
      "battery_status": "${OPP_BAT_STAT}",
      "health": "Optimal"
    }
  ]
}
JSON
