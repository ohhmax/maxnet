#!/bin/sh
# Require administrator authentication
. /www/cgi-bin/lib/auth_check.sh 2>/dev/null || . "$(dirname "$0")/lib/auth_check.sh" 2>/dev/null || exit 1
require_auth

printf '%s\n' 'Content-Type: application/json' 'Cache-Control: no-cache, no-store, must-revalidate' 'Access-Control-Allow-Methods: GET, POST, OPTIONS' 'Access-Control-Allow-Headers: Content-Type' ''

json_error() {
    jq -cn --arg message "$1" '{status:"error",message:$message}'
}

[ "$REQUEST_METHOD" = OPTIONS ] && exit 0

if [ "$REQUEST_METHOD" != POST ]; then
    EPOCH=$(date +%s 2>/dev/null || printf '0')
    TIMEZONE=$(uci -q get system.@system[0].timezone)
    ZONENAME=$(uci -q get system.@system[0].zonename)
    NTP=$(uci -q get system.ntp.enabled)
    [ -n "$NTP" ] || NTP=1
    NTP_SERVERS=$(uci -q show system.ntp 2>/dev/null | sed -n 's/^system.ntp.server=//p' | tr -d "'" | tr ' ' '\n' | jq -Rsc 'split("\n") | map(select(length > 0))')
    [ -n "$NTP_SERVERS" ] || NTP_SERVERS='[]'
    AUTO_REBOOT=$(uci -q get system.maxnet_settings.auto_reboot_enabled)
    AUTO_TIME=$(uci -q get system.maxnet_settings.auto_reboot_time)
    REPEATER_ENABLED=$(uci -q get system.maxnet_settings.repeater_enabled)
    [ -n "$TIMEZONE" ] || TIMEZONE=UTC0
    [ -n "$ZONENAME" ] || ZONENAME=Etc/UTC
    [ "$NTP" = 1 ] || NTP=0
    [ "$AUTO_REBOOT" = 1 ] || AUTO_REBOOT=0
    [ "$REPEATER_ENABLED" = 1 ] || REPEATER_ENABLED=0
    [ -n "$AUTO_TIME" ] || AUTO_TIME=
    jq -cn --argjson epoch "$EPOCH" --arg timezone "$TIMEZONE" --arg zonename "$ZONENAME" \
        --argjson ntp_enabled "$NTP" --argjson ntp_servers "$NTP_SERVERS" --argjson auto_reboot_enabled "$AUTO_REBOOT" --argjson repeater_enabled "$REPEATER_ENABLED" --arg auto_reboot_time "$AUTO_TIME" \
        '{status:"ok",epoch:$epoch,timezone:$timezone,zonename:$zonename,ntp_enabled:($ntp_enabled == 1),ntp_servers:$ntp_servers,auto_reboot_enabled:($auto_reboot_enabled == 1),auto_reboot_time:$auto_reboot_time,repeater_enabled:($repeater_enabled == 1)}'
    exit 0
fi

[ "${CONTENT_LENGTH:-0}" -gt 0 ] 2>/dev/null && [ "${CONTENT_LENGTH:-0}" -le 4096 ] 2>/dev/null || {
    json_error 'Missing or oversized JSON request body'
    exit 0
}
BODY=$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)
printf '%s' "$BODY" | jq -e 'type == "object"' >/dev/null 2>&1 || {
    json_error 'Invalid JSON request body'
    exit 0
}
ACTION=$(printf '%s' "$BODY" | jq -r '.action // empty')

case "$ACTION" in
    set_time)
        EPOCH=$(printf '%s' "$BODY" | jq -r '.epoch // empty')
        TIMEZONE=$(printf '%s' "$BODY" | jq -r '.timezone // empty')
        ZONENAME=$(printf '%s' "$BODY" | jq -r '.zonename // empty')
        NTP_VALUE=$(printf '%s' "$BODY" | jq -r 'if .ntp_enabled == true then "1" elif .ntp_enabled == false then "0" elif .ntp_enabled == 1 then "1" elif .ntp_enabled == 0 then "0" else "invalid" end')
        HAS_NTP_SERVERS=$(printf '%s' "$BODY" | jq -e 'has("ntp_servers")' >/dev/null 2>&1 && echo 1 || echo 0)
        if [ "$HAS_NTP_SERVERS" = 1 ]; then
            printf '%s' "$BODY" | jq -e '.ntp_servers | type == "array" and length <= 8 and all(.[]; type == "string" and length <= 253)' >/dev/null 2>&1 || {
                json_error 'ntp_servers must contain up to 8 valid hostnames'
                exit 0
            }
            for ntp_server in $(printf '%s' "$BODY" | jq -r '.ntp_servers[]'); do
                printf '%s' "$ntp_server" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$' || {
                    json_error 'Invalid NTP server hostname'
                    exit 0
                }
            done
        fi
        case "$EPOCH" in ''|*[!0-9]*) json_error 'epoch must be an integer timestamp'; exit 0 ;; esac
        [ "${#EPOCH}" -le 10 ] || { json_error 'epoch must be an integer timestamp'; exit 0; }
        [ "$EPOCH" -ge 946684800 ] 2>/dev/null && [ "$EPOCH" -le 4102444800 ] 2>/dev/null || {
            json_error 'epoch is outside the supported range (2000-2100)'
            exit 0
        }
        case "$TIMEZONE" in
            :*) [ "${TIMEZONE#:}" = "$ZONENAME" ] || { json_error 'Timezone path must match the selected zone name'; exit 0; } ;;
            *) printf '%s' "$TIMEZONE" | grep -Eq '^[A-Za-z0-9_+:/,<>.-]{1,128}$' || { json_error 'Invalid POSIX timezone string'; exit 0; } ;;
        esac
        case "$ZONENAME" in /*|*..*|*[!A-Za-z0-9_+./-]*|'') json_error 'Invalid timezone zone name'; exit 0 ;; esac
        case "$TIMEZONE" in
            :*) [ -f "/usr/share/zoneinfo/$ZONENAME" ] || {
                json_error 'Timezone zone name is not installed on this router'
                exit 0
            } ;;
        esac
        [ "$NTP_VALUE" != invalid ] || {
            json_error 'ntp_enabled must be a boolean'
            exit 0
        }
        uci -q set "system.@system[0].timezone=$TIMEZONE" &&
        uci -q set "system.@system[0].zonename=$ZONENAME" &&
        uci -q set "system.ntp.enabled=$NTP_VALUE" &&
        if [ "$HAS_NTP_SERVERS" = 1 ]; then
            uci -q delete system.ntp.server 2>/dev/null || :
            for ntp_server in $(printf '%s' "$BODY" | jq -r '.ntp_servers[]'); do
                uci -q add_list "system.ntp.server=$ntp_server" || { json_error 'Unable to save NTP server list'; exit 0; }
            done
        fi
        uci -q commit system || {
            json_error 'Unable to save time and NTP settings'
            exit 0
        }
        SET_DATE=$(date -d "@$EPOCH" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
        [ -n "$SET_DATE" ] && date -s "$SET_DATE" >/dev/null 2>&1 || {
            json_error 'Settings saved, but the system clock could not be set'
            exit 0
        }
        /etc/init.d/system reload >/dev/null 2>&1 || true
        if [ -x /etc/init.d/sysntpd ]; then
            /etc/init.d/sysntpd restart >/dev/null 2>&1 || {
                json_error 'Time settings saved, but NTP service restart failed'
                exit 0
            }
        fi
        jq -cn '{status:"ok",message:"Time settings applied"}'
        ;;
    set_repeater_enabled)
        ENABLED=$(printf '%s' "$BODY" | jq -r 'if .enabled == true then "1" elif .enabled == false then "0" elif .enabled == 1 then "1" elif .enabled == 0 then "0" else "invalid" end')
        [ "$ENABLED" != invalid ] || {
            json_error 'enabled must be a boolean'
            exit 0
        }
        uci -q set system.maxnet_settings=settings &&
        uci -q set "system.maxnet_settings.repeater_enabled=$ENABLED" &&
        uci -q commit system || {
            json_error 'Unable to save wireless repeater setting'
            exit 0
        }
        jq -cn --argjson enabled "$ENABLED" '{status:"ok",message:"Wireless repeater setting saved",enabled:($enabled == 1)}'
        ;;
    set_auto_reboot)
        ENABLED=$(printf '%s' "$BODY" | jq -r 'if .enabled == true then "1" elif .enabled == false then "0" elif .enabled == 1 then "1" elif .enabled == 0 then "0" else "invalid" end')
        REBOOT_TIME=$(printf '%s' "$BODY" | jq -r '.time // empty')
        [ "$ENABLED" != invalid ] || {
            json_error 'enabled must be a boolean'
            exit 0
        }
        if [ "$ENABLED" = 1 ]; then
            printf '%s' "$REBOOT_TIME" | grep -Eq '^([01][0-9]|2[0-3]):[0-5][0-9]$' || {
                json_error 'time must use 24-hour HH:MM format when automatic reboot is enabled'
                exit 0
            }
        else
            printf '%s' "$REBOOT_TIME" | grep -Eq '^([01][0-9]|2[0-3]):[0-5][0-9]$' || REBOOT_TIME=
        fi
        uci -q set system.maxnet_settings=settings &&
        uci -q set "system.maxnet_settings.auto_reboot_enabled=$ENABLED" &&
        uci -q set "system.maxnet_settings.auto_reboot_time=$REBOOT_TIME" &&
        uci -q commit system || {
            json_error 'Unable to save automatic reboot settings'
            exit 0
        }
        if [ "$ENABLED" = 1 ]; then
            /etc/init.d/maxnet-scheduled-reboot enable >/dev/null 2>&1 &&
            /etc/init.d/maxnet-scheduled-reboot start >/dev/null 2>&1 || {
                json_error 'Settings saved, but the reboot scheduler could not be started'
                exit 0
            }
        else
            /etc/init.d/maxnet-scheduled-reboot stop >/dev/null 2>&1 || :
            /etc/init.d/maxnet-scheduled-reboot disable >/dev/null 2>&1 || :
        fi
        jq -cn --arg time "$REBOOT_TIME" --argjson enabled "$ENABLED" \
            '{status:"ok",message:"Automatic reboot settings saved",enabled:($enabled == 1),time:$time}'
        ;;
    *)
        json_error 'Unknown action'
        ;;
esac
