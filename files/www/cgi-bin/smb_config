#!/bin/sh
# Require administrator authentication
. /www/cgi-bin/lib/auth_check.sh 2>/dev/null || . "$(dirname "$0")/lib/auth_check.sh" 2>/dev/null || exit 1
require_auth

printf "Content-Type: application/json\r\n\r\n"

SMB_USER=$(uci -q get samba4.pendrive.users || echo "max")
LAN_IP=$(uci -q get network.lan.ipaddr | awk '{print $1}')
[ -z "$LAN_IP" ] && LAN_IP="10.0.0.1"
SMB_IP="$LAN_IP"
SYS_HOST=$(uci -q get system.@system[0].hostname || echo "Maxnet-Gateway")
[ -z "$SYS_HOST" ] && SYS_HOST="Maxnet-Gateway"
SMB_HOST="$SYS_HOST"

# Check if pendrive is mounted or fallback storage available
MOUNTED=false
FREE_SPACE="--"
TOTAL_SPACE="--"
DEV_NAME="--"
if grep -qs "/mnt/pendrive" /proc/mounts || grep -qs "/mnt/storage" /proc/mounts; then
    MOUNTED=true
    DF_OUT=$(df -h /mnt/pendrive 2>/dev/null | tail -n1)
    [ -z "$DF_OUT" ] && DF_OUT=$(df -h /mnt/storage 2>/dev/null | tail -n1)
    DEV_NAME=$(echo "$DF_OUT" | awk '{print $1}')
    TOTAL_SPACE=$(echo "$DF_OUT" | awk '{print $2}')
    FREE_SPACE=$(echo "$DF_OUT" | awk '{print $4}')
else
    DF_OUT=$(df -h /mnt/pendrive 2>/dev/null | tail -n1)
    [ -z "$DF_OUT" ] && DF_OUT=$(df -h / 2>/dev/null | tail -n1)
    DEV_NAME="Fallback Storage"
    TOTAL_SPACE=$(echo "$DF_OUT" | awk '{print $2}')
    FREE_SPACE=$(echo "$DF_OUT" | awk '{print $4}')
fi

RUNNING=false
samba_enabled=$(uci -q get samba4.@samba[0].enabled || echo "0")
if pgrep smbd >/dev/null || [ "$samba_enabled" = "1" ]; then
    RUNNING=true
fi

if [ "$REQUEST_METHOD" = "POST" ]; then
    read -r POST_DATA
    ACTION=$(echo "$POST_DATA" | jq -r ".action // \"\"" 2>/dev/null)
    NEW_USER=$(echo "$POST_DATA" | jq -r ".username // \"\"" 2>/dev/null | tr -cd "a-zA-Z0-9_-")
    NEW_PASS=$(echo "$POST_DATA" | jq -r ".password // \"\"" 2>/dev/null)

    if [ "$ACTION" = "toggle" ]; then
        ENABLE_REQ=$(echo "$POST_DATA" | jq -r ".enable // empty" 2>/dev/null)
        if [ "$ENABLE_REQ" = "true" ]; then
            mkdir -p /mnt/pendrive /mnt/storage 2>/dev/null
            chmod 777 /mnt/pendrive /mnt/storage 2>/dev/null
            uci set samba4.@samba[0].enabled="1" 2>/dev/null
            uci commit samba4 2>/dev/null
            /etc/init.d/samba4 enable >/dev/null 2>&1
            /usr/bin/maxnet_storage_manager.sh --update >/dev/null 2>&1 || true
            /etc/init.d/samba4 restart >/dev/null 2>&1 || /etc/init.d/samba4 start >/dev/null 2>&1
            pgrep smbd >/dev/null || smbd -D 2>/dev/null || true
        elif [ "$ENABLE_REQ" = "false" ]; then
            uci set samba4.@samba[0].enabled="0" 2>/dev/null
            uci commit samba4 2>/dev/null
            /etc/init.d/samba4 stop >/dev/null 2>&1
            /etc/init.d/samba4 disable >/dev/null 2>&1
            killall smbd 2>/dev/null || true
        else
            if pgrep smbd >/dev/null; then
                uci set samba4.@samba[0].enabled="0" 2>/dev/null
                uci commit samba4 2>/dev/null
                /etc/init.d/samba4 stop >/dev/null 2>&1
                /etc/init.d/samba4 disable >/dev/null 2>&1
                killall smbd 2>/dev/null || true
            else
                mkdir -p /mnt/pendrive /mnt/storage 2>/dev/null
                chmod 777 /mnt/pendrive /mnt/storage 2>/dev/null
                uci set samba4.@samba[0].enabled="1" 2>/dev/null
                uci commit samba4 2>/dev/null
                /etc/init.d/samba4 enable >/dev/null 2>&1
                /usr/bin/maxnet_storage_manager.sh --update >/dev/null 2>&1 || true
                /etc/init.d/samba4 restart >/dev/null 2>&1 || /etc/init.d/samba4 start >/dev/null 2>&1
                pgrep smbd >/dev/null || smbd -D 2>/dev/null || true
            fi
        fi
        RUNNING=false
        samba_enabled=$(uci -q get samba4.@samba[0].enabled || echo "0")
        if pgrep smbd >/dev/null || [ "$samba_enabled" = "1" ]; then
            RUNNING=true
        fi
        printf "{\"status\":\"ok\",\"running\":%s,\"smb_running\":%s,\"message\":\"SMB service state updated\"}\n" "$RUNNING" "$RUNNING"
        exit 0
    fi

    if [ "$ACTION" = "set" ]; then
        if [ -z "$NEW_USER" ] || [ -z "$NEW_PASS" ]; then
            printf "{\"status\":\"error\",\"message\":\"Username and password cannot be empty\"}\n"
            exit 0
        fi

        # Ensure user exists in /etc/passwd
        if ! grep -q "^${NEW_USER}:" /etc/passwd; then
            echo "${NEW_USER}:x:1000:1000:${NEW_USER}:/mnt/pendrive:/bin/false" >> /etc/passwd
        fi

        # Set Samba password
        printf "%s\n%s\n" "$NEW_PASS" "$NEW_PASS" | smbpasswd -s -a "$NEW_USER" >/dev/null 2>&1

        # Update UCI if changed
        uci set samba4.pendrive.users="$NEW_USER"
        uci commit samba4
        /etc/init.d/samba4 restart >/dev/null 2>&1

        printf "{\"status\":\"ok\",\"message\":\"SMB credentials updated successfully for user %s\"}\n" "$NEW_USER"
        exit 0
    fi
fi

# Support GET action=toggle
if [ "$REQUEST_METHOD" = "GET" ]; then
    QUERY_ACTION=$(echo "$QUERY_STRING" | sed -n 's/^.*action=\([^&]*\).*$/\1/p')
    if [ "$QUERY_ACTION" = "toggle" ]; then
        if pgrep smbd >/dev/null; then
            uci set samba4.@samba[0].enabled="0" 2>/dev/null
            uci commit samba4 2>/dev/null
            /etc/init.d/samba4 stop >/dev/null 2>&1
            /etc/init.d/samba4 disable >/dev/null 2>&1
            killall smbd 2>/dev/null || true
        else
            mkdir -p /mnt/pendrive /mnt/storage 2>/dev/null
            chmod 777 /mnt/pendrive /mnt/storage 2>/dev/null
            uci set samba4.@samba[0].enabled="1" 2>/dev/null
            uci commit samba4 2>/dev/null
            /etc/init.d/samba4 enable >/dev/null 2>&1
            /usr/bin/maxnet_storage_manager.sh --update >/dev/null 2>&1 || true
            /etc/init.d/samba4 restart >/dev/null 2>&1 || /etc/init.d/samba4 start >/dev/null 2>&1
            pgrep smbd >/dev/null || smbd -D 2>/dev/null || true
        fi
        RUNNING=false
        samba_enabled=$(uci -q get samba4.@samba[0].enabled || echo "0")
        if pgrep smbd >/dev/null || [ "$samba_enabled" = "1" ]; then
            RUNNING=true
        fi
        printf "{\"status\":\"ok\",\"running\":%s,\"smb_running\":%s,\"message\":\"SMB service state toggled\"}\n" "$RUNNING" "$RUNNING"
        exit 0
    fi
fi

# Default response
printf "{\"status\":\"ok\",\"running\":%s,\"smb_running\":%s,\"username\":\"%s\",\"share_name\":\"Pendrive\",\"share_path\":\"/mnt/pendrive\",\"share_ip\":\"%s\",\"hostname\":\"%s\",\"mounted\":%s,\"device\":\"%s\",\"total_space\":\"%s\",\"free_space\":\"%s\"}\n" \
  "$RUNNING" "$RUNNING" "$SMB_USER" "$SMB_IP" "$SMB_HOST" "$MOUNTED" "$DEV_NAME" "$TOTAL_SPACE" "$FREE_SPACE"
