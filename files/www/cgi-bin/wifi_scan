#!/bin/sh
# Require administrator authentication
. /www/cgi-bin/lib/auth_check.sh 2>/dev/null || . "$(dirname "$0")/lib/auth_check.sh" 2>/dev/null || exit 1
require_auth

printf '%s\r\n' 'Content-Type: application/json' 'Cache-Control: no-cache, no-store, must-revalidate' 'Access-Control-Allow-Methods: GET, OPTIONS' 'Access-Control-Allow-Headers: Content-Type' ''

json_error() {
    jq -cn --arg message "$1" '{status:"error",message:$message}'
}

query_value() {
    printf '%s' "${QUERY_STRING:-}" | tr '&' '\n' | sed -n "s/^$1=//p" | sed -n '1p'
}

[ "${REQUEST_METHOD:-GET}" = OPTIONS ] && exit 0

ACTION=$(query_value action)
SOURCE=$(query_value source)
[ -n "$ACTION" ] || ACTION=status
REPEATER_ENABLED=$(uci -q get system.maxnet_settings.repeater_enabled)
[ "$REPEATER_ENABLED" = 1 ] || REPEATER_ENABLED=0

case "$ACTION" in
    status)
        ;;
    scan)
        if [ "$SOURCE" = repeater ] && [ "$REPEATER_ENABLED" != 1 ]; then
            json_error 'Enable wireless repeater controls before scanning'
            exit 0
        fi
        command -v iwinfo >/dev/null 2>&1 || {
            json_error 'Wireless scan tool (iwinfo) is not installed'
            exit 0
        }
        ;;
    *)
        json_error 'Unknown Wi-Fi scan action'
        exit 0
        ;;
esac

SCAN_JSON='[]'
if [ "$ACTION" = scan ]; then
    SCAN_RAW=$(for wdev in $(iw dev 2>/dev/null | awk '/Interface/{print $2}'); do iwinfo "$wdev" scan 2>/dev/null; done)
    SCAN_JSON=$(printf '%s\n' "$SCAN_RAW" | awk '
    function quote_json(value, result, i, character) {
        result = "\""
        for (i = 1; i <= length(value); i++) {
            character = substr(value, i, 1)
            if (character == "\\") result = result "\\\\"
            else if (character == "\"") result = result "\\\""
            else if (character == "\n") result = result "\\n"
            else if (character == "\r") result = result "\\r"
            else if (character == "\t") result = result "\\t"
            else result = result character
        }
        return result "\""
    }
    function emit_network() {
        if (bssid == "" || ssid == "") return
        if (!first) printf ","
        printf "{\"bssid\":%s,\"ssid\":%s,\"freq\":%d,\"channel\":%s,\"signal_dbm\":%s,\"encryption\":%s,\"band\":%s,\"device\":%s}", quote_json(bssid), quote_json(ssid), frequency, quote_json(channel), quote_json(signal), quote_json(encryption), quote_json(band), quote_json(device)
        first = 0
    }
    BEGIN { printf "["; first = 1 }
    /^Cell [0-9]+ - Address:/ {
        emit_network()
        bssid = tolower($5)
        ssid = ""; frequency = 0; channel = ""; signal = "-70"; encryption = "Open"; band = ""; device = ""
    }
    /^[ \t]*ESSID:/ {
        sub(/^[ \t]*ESSID: *\"?/, "")
        sub(/\"$/, "")
        ssid = $0
    }
    /^[ \t]*Mode:/ {
        for (i = 1; i <= NF; i++) {
            if ($i == "Frequency:") {
                frequency = int($(i + 1) * 1000)
                break
            }
        }
        for (i = 1; i <= NF; i++) {
            if ($i == "Channel:") { channel = $(i + 1); break }
        }
        if (frequency > 4000) { band = "5GHz"; device = "radio1" }
        else { band = "2.4GHz"; device = "radio0" }
    }
    /^[ \t]*Signal:/ { signal = $2 }
    /^[ \t]*Encryption:/ {
        sub(/^[ \t]*Encryption: */, "")
        encryption = ($0 ~ /none/i) ? "Open" : $0
    }
    END { emit_network(); printf "]" }
    ')
    [ -n "$SCAN_JSON" ] || SCAN_JSON='[]'
fi

WWAN_SSID=$(uci -q get wireless.wwan.ssid)
WWAN_DEV=$(uci -q get wireless.wwan.device)
WWAN_PROTO=$(uci -q get network.wwan.proto)
WWAN_STATUS=disconnected
WWAN_IP=

if [ -n "$WWAN_SSID" ]; then
    WWAN_UBUS=$(ubus call network.interface.wwan status 2>/dev/null)
    WWAN_UP=$(printf '%s' "$WWAN_UBUS" | jq -r '.up // false' 2>/dev/null)
    WWAN_IP=$(printf '%s' "$WWAN_UBUS" | jq -r '."ipv4-address"[0].address // empty' 2>/dev/null)
    if [ -z "$WWAN_IP" ]; then
        WWAN_IP=$(ip -4 a show dev phy0-sta0 2>/dev/null | awk '/inet / {print $2}' | awk -F/ '{print $1}')
        [ -n "$WWAN_IP" ] || WWAN_IP=$(ip -4 a show dev phy1-sta0 2>/dev/null | awk '/inet / {print $2}' | awk -F/ '{print $1}')
    fi
    if [ "$WWAN_UP" = true ] || [ -n "$WWAN_IP" ]; then
        WWAN_STATUS=connected
    else
        WWAN_STATUS=connecting
    fi
fi

jq -cn \
    --arg status "$WWAN_STATUS" \
    --arg ssid "$WWAN_SSID" \
    --arg ip "$WWAN_IP" \
    --arg device "$WWAN_DEV" \
    --arg proto "${WWAN_PROTO:-dhcp}" \
    --argjson repeater_enabled "$REPEATER_ENABLED" \
    --argjson networks "$SCAN_JSON" \
    '{status:"ok",repeater_enabled:($repeater_enabled == 1),client_wan:{status:$status,ssid:$ssid,ip:$ip,device:$device,proto:$proto},networks:$networks}'
