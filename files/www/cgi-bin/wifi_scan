#!/bin/sh
printf "Content-Type: application/json\r\n\r\n"

# Trigger background scan if requested or interfaces are idle
( iw dev phy0-ap0 scan >/dev/null 2>&1; iw dev phy1-ap0 scan >/dev/null 2>&1 ) &

# Parse scan results from both 2.4GHz (phy0-ap0) and 5GHz (phy1-ap0)
SCAN_JSON=$( (iw dev phy0-ap0 scan dump 2>/dev/null; iw dev phy1-ap0 scan dump 2>/dev/null) | awk '
BEGIN { printf "["; first=1; }
/^BSS / {
    if (bssid != "" && ssid != "") {
        if (!first) printf ",";
        printf "{\"bssid\":\"%s\",\"ssid\":\"%s\",\"freq\":%d,\"channel\":\"%s\",\"signal_dbm\":\"%s\",\"encryption\":\"%s\",\"band\":\"%s\",\"device\":\"%s\"}", bssid, ssid, freq, chan, sig, enc, band, dev;
        first=0;
    }
    bssid = tolower($2);
    sub(/\(.*/, "", bssid);
    ssid = ""; freq = 0; chan = ""; sig = "-70"; enc = "Open"; band = ""; dev = "";
}
/freq:/ {
    freq = int($2);
    if (freq > 4000) { band="5GHz"; dev="radio1"; }
    else { band="2.4GHz"; dev="radio0"; }
}
/primary channel:/ { chan = $NF; }
/DS Parameter set: channel/ { chan = $NF; }
/signal:/ { sig = $2; }
/SSID:/ {
    sub(/^[ \t]*SSID: */, "");
    ssid = $0;
}
/RSN:/ { enc = "WPA2/WPA3 PSK"; }
/WPA:/ && enc == "Open" { enc = "WPA PSK"; }
END {
    if (bssid != "" && ssid != "") {
        if (chan == "") {
            if (freq >= 5000) chan = int((freq - 5000) / 5);
            else if (freq >= 2412) chan = int((freq - 2407) / 5);
        }
        if (!first) printf ",";
        printf "{\"bssid\":\"%s\",\"ssid\":\"%s\",\"freq\":%d,\"channel\":\"%s\",\"signal_dbm\":\"%s\",\"encryption\":\"%s\",\"band\":\"%s\",\"device\":\"%s\"}", bssid, ssid, freq, chan, sig, enc, band, dev;
    }
    printf "]";
}')

# Check active WWAN client status
WWAN_SSID=$(uci -q get wireless.wwan.ssid)
WWAN_DEV=$(uci -q get wireless.wwan.device)
WWAN_PROTO=$(uci -q get network.wwan.proto)
WWAN_STATUS="disconnected"
WWAN_IP=""

if [ -n "$WWAN_SSID" ]; then
    WWAN_UBUS=$(ubus call network.interface.wwan status 2>/dev/null)
    WWAN_UP=$(echo "$WWAN_UBUS" | jq -r '.up // false' 2>/dev/null)
    WWAN_IP=$(echo "$WWAN_UBUS" | jq -r '."ipv4-address"[0].address // empty' 2>/dev/null)
    if [ -z "$WWAN_IP" ]; then
        WWAN_IP=$(ip -4 a show dev phy0-sta0 2>/dev/null | awk '/inet / {print $2}' | awk -F'/' '{print $1}')
        [ -z "$WWAN_IP" ] && WWAN_IP=$(ip -4 a show dev phy1-sta0 2>/dev/null | awk '/inet / {print $2}' | awk -F'/' '{print $1}')
    fi
    if [ "$WWAN_UP" = "true" ] || [ -n "$WWAN_IP" ]; then
        WWAN_STATUS="connected"
    else
        WWAN_STATUS="connecting"
    fi
fi

cat << JSON_END
{
  "status": "ok",
  "client_wan": {
    "status": "${WWAN_STATUS}",
    "ssid": "${WWAN_SSID}",
    "ip": "${WWAN_IP}",
    "device": "${WWAN_DEV}",
    "proto": "${WWAN_PROTO:-dhcp}"
  },
  "networks": ${SCAN_JSON:-[]}
}
JSON_END
