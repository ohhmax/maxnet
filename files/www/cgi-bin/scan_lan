#!/bin/sh
echo "Content-Type: application/json"
echo "Cache-Control: no-cache, no-store, must-revalidate"
echo "Access-Control-Allow-Origin: *"
echo ""

# Fast non-blocking broadcast ping to populate IPv4 ARP table
ping -c 2 -W 1 -b 10.0.0.255 >/dev/null 2>&1 &

# Dual-stack IPv6 all-nodes multicast ping to populate IPv6 NDP neighbor table
ping -6 -c 2 -I br-lan ff02::1 >/dev/null 2>&1 &

# Parallel Layer-2 ARP and ICMP probe for all known DHCP leases and hosts
(
    IPS=$( { awk '{print $3}' /tmp/dhcp.leases 2>/dev/null; \
             awk '/^10\.0\.0\./ {print $1}' /etc/hosts 2>/dev/null; \
             echo "10.0.0.1 10.0.0.2 10.0.0.5 10.0.0.110 10.0.0.111 10.0.0.166 10.0.0.238"; } | sort -u )
    for ip in $IPS; do
        [ -z "$ip" ] && continue
        /usr/bin/arping -f -q -c 2 -w 2 -I br-lan "$ip" >/dev/null 2>&1 &
        ping -c 2 -W 2 "$ip" >/dev/null 2>&1 &
    done
) >/dev/null 2>&1 &

# Asynchronous background NetBIOS name collector
(
    TMP="/tmp/netbios_cache.tmp"
    echo "{" > "$TMP"
    FIRST=1
    for ip in $(awk '{print $3}' /tmp/dhcp.leases 2>/dev/null; awk '/^10\.0\.0\./ {print $1}' /etc/hosts 2>/dev/null; echo "10.0.0.1 10.0.0.2 10.0.0.5 10.0.0.110 10.0.0.111 10.0.0.166 10.0.0.238"); do
        [ -z "$ip" ] && continue
        nb=$(/usr/bin/nmblookup -A "$ip" 2>/dev/null | awk '/<00> - / && !/GROUP/ {print $1; exit}')
        if [ -n "$nb" ]; then
            [ "$FIRST" -eq 0 ] && echo "," >> "$TMP"
            echo -n "  \"$ip\": \"$nb\"" >> "$TMP"
            FIRST=0
        fi
    done
    echo "" >> "$TMP"
    echo "}" >> "$TMP"
    mv "$TMP" /tmp/netbios_cache.json
) >/dev/null 2>&1 &

echo '{"status": "ok", "message": "LAN dual-stack IPv4/IPv6 Layer 2 & 3 scan triggered"}'
