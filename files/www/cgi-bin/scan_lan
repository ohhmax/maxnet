#!/bin/sh
# Require administrator authentication
. /www/cgi-bin/lib/auth_check.sh 2>/dev/null || . "$(dirname "$0")/lib/auth_check.sh" 2>/dev/null || exit 1
require_auth

echo "Content-Type: application/json"
echo "Cache-Control: no-cache, no-store, must-revalidate"
echo ""

LAN_IP=$(ip -4 a show dev br-lan 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 | head -n 1)
[ -z "$LAN_IP" ] && LAN_IP=$(uci -q get network.lan.ipaddr | awk '{print $1}' | cut -d/ -f1)
[ -z "$LAN_IP" ] && LAN_IP="10.0.0.1"
LAN_PREFIX="${LAN_IP%.*}."
LAN_BCAST=$(ip -4 a show dev br-lan 2>/dev/null | awk '/inet .* brd / {print $4; exit}')
[ -z "$LAN_BCAST" ] && LAN_BCAST="${LAN_PREFIX}255"

# Fast non-blocking broadcast ping to populate IPv4 ARP table
ping -c 2 -W 1 -b "$LAN_BCAST" >/dev/null 2>&1 &

# Dual-stack IPv6 all-nodes multicast ping to populate IPv6 NDP neighbor table
ping -6 -c 2 -I br-lan ff02::1 >/dev/null 2>&1 &

# Parallel Layer-2 ARP and ICMP probe for all known DHCP leases, hosts, and active ARP neighbors
(
    IPS=$( { awk '{print $3}' /tmp/dhcp.leases 2>/dev/null; \
             awk -v pfx="$LAN_PREFIX" 'index($1, pfx) == 1 {print $1}' /etc/hosts 2>/dev/null; \
             ip -4 neigh show dev br-lan 2>/dev/null | awk '{print $1}'; \
             echo "$LAN_IP"; } | sort -u )
    for ip in $IPS; do
        [ -z "$ip" ] && continue
        /usr/bin/arping -f -q -c 2 -w 2 -I br-lan "$ip" >/dev/null 2>&1 &
        ping -c 2 -W 2 "$ip" >/dev/null 2>&1 &
    done
) >/dev/null 2>&1 &

# Asynchronous background NetBIOS name collector
(
    TMP="/tmp/netbios_cache.tmp"
    echo "{" > "$TMP"
    FIRST=1
    for ip in $( { awk '{print $3}' /tmp/dhcp.leases 2>/dev/null; awk -v pfx="$LAN_PREFIX" 'index($1, pfx) == 1 {print $1}' /etc/hosts 2>/dev/null; ip -4 neigh show dev br-lan 2>/dev/null | awk '{print $1}'; } | sort -u ); do
        [ -z "$ip" ] && continue
        nb=$(/usr/bin/nmblookup -A "$ip" 2>/dev/null | awk '/<00> - / && !/GROUP/ {print $1; exit}')
        if [ -n "$nb" ]; then
            [ "$FIRST" -eq 0 ] && echo "," >> "$TMP"
            echo -n "  \"$ip\": \"$nb\"" >> "$TMP"
            FIRST=0
        fi
    done
    echo "" >> "$TMP"
    echo "}" >> "$TMP"
    mv "$TMP" /tmp/netbios_cache.json
) >/dev/null 2>&1 &

echo '{"status": "ok", "message": "LAN dual-stack IPv4/IPv6 Layer 2 & 3 scan triggered"}'
