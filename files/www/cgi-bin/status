for dev in /sys/bus/usb/devices/*; do
  [ -f "$dev/bDeviceClass" ] || continue
  bname=$(basename "$dev")
  case "$bname" in
    usb*|*:*) continue ;;
  esac
  cls=$(cat "$dev/bDeviceClass" 2>/dev/null)
  if [ "$cls" = "09" ]; then
    HAS_HUB=true
    HUB_BUS="$bname"
    HUB_MODEL=$(cat "$dev/product" 2>/dev/null || echo "USB 3.0 Hub")
    HUB_MFG=$(cat "$dev/manufacturer" 2>/dev/null || echo "GenesysLogic")
    HUB_PORTS=$(cat "$dev/maxchild" 2>/dev/null || echo 4)
    HUB_SPEED=$(cat "$dev/speed" 2>/dev/null || echo 5000)
    continue
  fi
  HAS_USB_DEV=true
  spd=$(cat "$dev/speed" 2>/dev/null || echo 0)
  case "$spd" in
    5000|10000|20000)
      USB_DEV_SPEED=$spd
      USB_DEV_LINK="USB 3.0 SuperSpeed"
      ;;
    480)
