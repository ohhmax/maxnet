P_FREQ=$(echo "$MOBILE_JSON" | jq -r '.cellular.frequency // "3.5 GHz C-Band"')
P_ARFCN=$(echo "$MOBILE_JSON" | jq -r '.cellular.arfcn // "634080"')
P_RSRP=$(echo "$MOBILE_JSON" | jq -r '.cellular.rsrp_dbm // -98')
P_SINR=$(echo "$MOBILE_JSON" | jq -r '.cellular.sinr_db // 13')
