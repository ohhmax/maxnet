      case "$dev_speed" in
        10000*) p_ver="U3.2"; p_ver_name="USB 3.2 Gen 2 (10 Gbps)" ;;
        5000*)  p_ver="U3.0"; p_ver_name="USB 3.0 SuperSpeed (5 Gbps)" ;;
