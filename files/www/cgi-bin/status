      esac
    else
      # Available Port capability derived from Hub controller class/speed
      case "${HUB_SPEED:-5000}" in
        10000*) p_ver="U3.2"; p_ver_name="USB 3.2 Ready (10 Gbps)"; dev_speed=10000 ;;
        5000*)  p_ver="U3.0"; p_ver_name="USB 3.0 Ready (5 Gbps)"; dev_speed=5000 ;;
