P_PA_TEMP=$(echo "$MOBILE_JSON" | jq -r '.cellular.pa_temp_c // 44.0')
P_CELL_IP=$(echo "$MOBILE_JSON" | jq -r '.cell_ip // "192.0.0.2"')
P_NEIGHBORS=$(echo "$MOBILE_JSON" | jq -c '.cellular.neighbors // []')

STAT_JSON="/tmp/traffic_stats.json"; [ ! -f "$STAT_JSON" ] && [ -f "/etc/traffic_stats.json" ] && STAT_JSON="/etc/traffic_stats.json"; if [ -f "$STAT_JSON" ]; then
    WAN_RX_B=$(jq -r '.wan.rx_bytes // 0' "$STAT_JSON" 2>/dev/null)
    WAN_TX_B=$(jq -r '.wan.tx_bytes // 0' "$STAT_JSON" 2>/dev/null)
    USB_RX_MB=$(jq -r '.wan.rx_mb // "0.00"' "$STAT_JSON" 2>/dev/null)
    USB_TX_MB=$(jq -r '.wan.tx_mb // "0.00"' "$STAT_JSON" 2>/dev/null)
    WAN_TOT_MB=$(jq -r '.wan.total_mb // "0.00"' "$STAT_JSON" 2>/dev/null)
else
    WAN_RX_B=$USB_RX_B
