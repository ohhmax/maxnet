TS_HOST=$(echo "$TS_RAW" | jq -r '.Self.HostName // "Maxnet-USB"' 2>/dev/null)
if [ "$P_CONN" = "true" ] && [ -n "$P_PCI" ] && [ "$P_PCI" != "0" ]; then
    TOWERS_JSON=$(jq -n \
      --argjson serv "{\"pci\": ${P_PCI:-0}, \"band\": \"n${P_BAND}\", \"freq\": \"${P_FREQ}\", \"arfcn\": \"${P_ARFCN}\", \"rsrp_dbm\": ${P_RSRP:-0}, \"sinr_db\": ${P_SINR:-0}, \"carrier\": \"${P_OP}\", \"is_serving\": true, \"status\": \"Connected\"}" \
      --argjson neigh "${P_NEIGHBORS:-[]}" \
      "[\$serv] + [(\$neigh[] | . + {\"is_serving\": false, \"status\": \"Available\"})]" 2>/dev/null)
fi
[ -z "$TOWERS_JSON" ] && TOWERS_JSON="[]"
export HOME=/root
ADB_DEVS=$(adb devices -l 2>/dev/null | awk 'BEGIN{printf "[";c=0} NR>1 && $2=="device"{s=$1; m="Android"; for(i=3;i<=NF;i++) if($i ~ /^model:/) m=substr($i,7); if(c>0) printf ","; printf "{\"serial\":\"%s\",\"model\":\"%s\"}", s, m; c++} END{printf "]"}')
[ -z "$ADB_DEVS" ] && ADB_DEVS="[]"

HAS_HUB=false
HUB_MODEL=""
HUB_MFG=""
HUB_PORTS=0
HUB_SPEED=0

for dev in /sys/bus/usb/devices/*; do
  [ -f "$dev/bDeviceClass" ] || continue
  bname=$(basename "$dev")
  case "$bname" in
    usb*|*:*) continue ;;
  esac
  cls=$(cat "$dev/bDeviceClass" 2>/dev/null)
  if [ "$cls" = "09" ]; then
    HAS_HUB=true
    HUB_MODEL=$(cat "$dev/product" 2>/dev/null || echo "USB Hub")
    HUB_MFG=$(cat "$dev/manufacturer" 2>/dev/null || echo "Generic")
    HUB_PORTS=$(cat "$dev/maxchild" 2>/dev/null || echo 4)
    HUB_SPEED=$(cat "$dev/speed" 2>/dev/null || echo 5000)
    break
  fi
done

USB_HUB_JSON=$(jq -n   --argjson connected "$HAS_HUB"   --arg model "$HUB_MODEL"   --arg mfg "$HUB_MFG"   --argjson ports "${HUB_PORTS:-0}"   --argjson speed "${HUB_SPEED:-0}"   '{"connected": $connected, "model": $model, "manufacturer": $mfg, "ports": $ports, "speed_mbps": $speed}')
if [ -f /tmp/multilink_status.json ]; then MULTILINK_JSON=$(cat /tmp/multilink_status.json); else MULTILINK_JSON=x27{"active_count":1,"mode":"AUTO MERGE","limit_mbps":0,"combined_speed_mbps":0,"links":[]}x27; fi
cat << JSON
