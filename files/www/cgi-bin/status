  HUB_PORTS_JSON="["
  hub_first=1
  for p in $(seq 1 $HUB_PORTS); do
    port_status="available"
    dev_name=""
    dev_type=""
    dev_speed=0
    dev_bus=""

    # Dual-tier Hub scan: matches USB 3.x tier (e.g. 2-1.p) or USB 2.0 tier (e.g. 1-1.p)
    child=$(ls -d /sys/bus/usb/devices/*-[0-9].${p} /sys/bus/usb/devices/*-*.${p} 2>/dev/null | head -n 1)
    if [ -n "$child" ] && [ -f "$child/speed" ]; then
      port_status="connected"
      HUB_CONN_COUNT=$((HUB_CONN_COUNT + 1))
      dev_bus=$(basename "$child")
      dev_name=$(cat "$child/product" 2>/dev/null || echo "USB Device")
      dev_speed=$(cat "$child/speed" 2>/dev/null || echo 480)
      icls=$(cat "$child/"*":1.0/bInterfaceClass" 2>/dev/null | head -n 1)
      if [ "$icls" = "08" ] || [ "$USB_STORAGE_MOUNTED" = "true" ]; then
        dev_type="storage"
      elif [ "$icls" = "e0" ] || [ "$icls" = "02" ]; then
        dev_type="modem"
