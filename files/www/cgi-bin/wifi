#!/bin/sh
# ==============================================================================
# MAXNET HIGH-PERFORMANCE DUAL-BAND WI-FI & HOTSPOT ENGINE
# Manages 2.4 GHz & 5 GHz wireless configuration, security, channels, & clients
# ==============================================================================
# Require administrator authentication
. /www/cgi-bin/lib/auth_check.sh 2>/dev/null || . "$(dirname "$0")/lib/auth_check.sh" 2>/dev/null || exit 1
require_auth

echo "Content-Type: application/json"
echo "Cache-Control: no-cache, no-store, must-revalidate"
echo ""

ACTION="$1"
[ -z "$ACTION" ] && ACTION=$(printf '%s' "$QUERY_STRING" | tr '&' '\n' | sed -n 's/^action=//p' | head -n 1)
[ -z "$ACTION" ] && ACTION="get"

json_error() {
    jq -cn --arg message "$1" '{status:"error",message:$message}'
}

read_client_body() {
    [ "${CONTENT_LENGTH:-0}" -gt 0 ] 2>/dev/null && [ "$CONTENT_LENGTH" -le 4096 ] 2>/dev/null || return 1
    dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null
}

valid_client_mac() {
    printf '%s' "$1" | grep -Eq '^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$' || return 1
    [ "$1" != 00:00:00:00:00:00 ] || return 1
    first=$(printf '%s' "$1" | cut -d: -f1)
    first_value=$((0x$first))
    [ $((first_value % 2)) -eq 0 ]
}

set_station_ban() {
    mac=$1
    ban_time=$2
    [ -n "$mac" ] || return 1
    command -v ubus >/dev/null 2>&1 || return 1
    found=0
    for object in $(ubus list 'hostapd.*' 2>/dev/null); do
        if [ "$ban_time" -eq 0 ]; then
            args="{\"addr\":\"$mac\",\"reason\":5,\"deauth\":false,\"ban_only\":true,\"ban_time\":0}"
        else
            args="{\"addr\":\"$mac\",\"reason\":5,\"deauth\":true,\"deauth_now\":true,\"ban_time\":$ban_time}"
        fi
        if ubus call "$object" del_client "$args" >/dev/null 2>&1; then
            found=1
        fi
    done
    [ "$found" -eq 1 ]
}

if [ "$REQUEST_METHOD" = OPTIONS ]; then
    exit 0
fi

BODY=
if [ "$REQUEST_METHOD" = POST ]; then
    BODY=$(read_client_body) || {
        json_error 'Missing or oversized JSON request body'
        exit 0
    }
    printf '%s' "$BODY" | jq -e 'type == "object"' >/dev/null 2>&1 || {
        json_error 'Invalid JSON request body'
        exit 0
    }
    BODY_ACTION=$(printf '%s' "$BODY" | jq -r '.action // empty' 2>/dev/null)
    [ -z "$BODY_ACTION" ] || ACTION=$BODY_ACTION
fi

if [ "$ACTION" = "client_block" ] || [ "$ACTION" = "client_kick" ]; then
    MAC=$(printf '%s' "$BODY" | jq -r '.mac // empty' | tr '[:upper:]' '[:lower:]')
    valid_client_mac "$MAC" || {
        json_error 'Invalid unicast MAC address'
        exit 0
    }
    if [ "$ACTION" = client_kick ]; then
        KICKED=0
        if command -v ubus >/dev/null 2>&1; then
            for object in $(ubus list 'hostapd.*' 2>/dev/null); do
                if ubus call "$object" del_client "{\"addr\":\"$MAC\",\"reason\":5,\"deauth\":true,\"ban_time\":0}" >/dev/null 2>&1; then
                    KICKED=1
                fi
            done
        fi
        if [ "$KICKED" -eq 0 ] && command -v iw >/dev/null 2>&1; then
            for wdev in $(iw dev 2>/dev/null | awk '/Interface/ {print $2}'); do
                iw dev "$wdev" station del "$MAC" >/dev/null 2>&1 && KICKED=1
            done
        fi
        [ "$KICKED" -eq 1 ] || {
            json_error 'Station is not connected or hostapd could not disconnect it'
            exit 0
        }
        jq -cn '{status:"ok",message:"Wi-Fi station disconnected"}'
        exit 0
    fi

    BLOCKED=$(printf '%s' "$BODY" | jq -r 'if .blocked == true then "1" elif .blocked == false then "0" else "invalid" end')
    [ "$BLOCKED" != invalid ] || {
        json_error 'blocked must be a boolean'
        exit 0
    }
    BLOCK_FILE=/etc/maxnet_wifi_blocked_macs
    TMP_BLOCK=$(mktemp /etc/maxnet_wifi_blocked_macs.XXXXXX) || {
        json_error 'Unable to prepare persistent Wi-Fi block list'
        exit 0
    }
    if [ -f "$BLOCK_FILE" ]; then
        grep -Eiv "^${MAC}$" "$BLOCK_FILE" > "$TMP_BLOCK" 2>/dev/null || :
    fi
    if [ "$BLOCKED" = 1 ]; then
        printf '%s\n' "$MAC" >> "$TMP_BLOCK"
    fi
    sort -u "$TMP_BLOCK" -o "$TMP_BLOCK" || {
        rm -f "$TMP_BLOCK"
        json_error 'Unable to update persistent Wi-Fi block list'
        exit 0
    }
    chmod 600 "$TMP_BLOCK"
    mv "$TMP_BLOCK" "$BLOCK_FILE" || {
        rm -f "$TMP_BLOCK"
        json_error 'Unable to persist Wi-Fi block list'
        exit 0
    }
    if [ "$BLOCKED" = 1 ]; then
        set_station_ban "$MAC" 4294967295 || :
    else
        set_station_ban "$MAC" 0 || :
    fi
    jq -cn --argjson blocked "$BLOCKED" --arg mac "$MAC" \
        '{status:"ok",message:(if $blocked then "Wi-Fi station blocked" else "Wi-Fi station unblocked" end),mac:$mac,blocked:($blocked == 1)}'
    exit 0
fi

# Ensure wireless config file exists
if [ ! -f /etc/config/wireless ]; then
    touch /etc/config/wireless
    wifi config 2>/dev/null || true
fi

# 1. HANDLE SETTINGS SAVE (POST / SET)
if [ "$ACTION" = "set" ] || [ "$REQUEST_METHOD" = "POST" ]; then
    if [ -n "$BODY" ]; then
        eval "$(printf '%s' "$BODY" | jq -r '
          def val(k): if .[k] == false then "0" elif .[k] == true then "1" elif .[k] != null then (.[k]|tostring) else "" end;
          "MASTER_EN=" + (val("master_enabled") | @sh) + "\n" +
          "EN_2G=" + (val("enable_2g") | @sh) + "\n" +
          "SSID_2G=" + (val("ssid_2g") | @sh) + "\n" +
          "KEY_2G=" + (val("key_2g") | @sh) + "\n" +
          "ENC_2G=" + (val("enc_2g") | @sh) + "\n" +
          "CH_2G=" + (val("channel_2g") | @sh) + "\n" +
          "HT_2G=" + (val("htmode_2g") | @sh) + "\n" +
          "HIDDEN_2G=" + (val("hidden_2g") | @sh) + "\n" +
          "EN_5G=" + (val("enable_5g") | @sh) + "\n" +
          "SSID_5G=" + (val("ssid_5g") | @sh) + "\n" +
          "KEY_5G=" + (val("key_5g") | @sh) + "\n" +
          "ENC_5G=" + (val("enc_5g") | @sh) + "\n" +
          "CH_5G=" + (val("channel_5g") | @sh) + "\n" +
          "HT_5G=" + (val("htmode_5g") | @sh) + "\n" +
          "HIDDEN_5G=" + (val("hidden_5g") | @sh)
        ' 2>/dev/null)"
    fi

    # Fallback to query string if body did not contain parameter
    get_qs_val() {
        printf '%s' "$QUERY_STRING" | sed -n "s/^.*$1=\([^&]*\).*$/\1/p"
    }
    [ -z "$MASTER_EN" ] && MASTER_EN=$(get_qs_val "master_enabled")
    [ -z "$EN_2G" ] && EN_2G=$(get_qs_val "enable_2g")
    [ -z "$SSID_2G" ] && SSID_2G=$(get_qs_val "ssid_2g")
    [ -z "$KEY_2G" ] && KEY_2G=$(get_qs_val "key_2g")
    [ -z "$ENC_2G" ] && ENC_2G=$(get_qs_val "enc_2g")
    [ -z "$CH_2G" ] && CH_2G=$(get_qs_val "channel_2g")
    [ -z "$HT_2G" ] && HT_2G=$(get_qs_val "htmode_2g")
    [ -z "$HIDDEN_2G" ] && HIDDEN_2G=$(get_qs_val "hidden_2g")

    [ -z "$EN_5G" ] && EN_5G=$(get_qs_val "enable_5g")
    [ -z "$SSID_5G" ] && SSID_5G=$(get_qs_val "ssid_5g")
    [ -z "$KEY_5G" ] && KEY_5G=$(get_qs_val "key_5g")
    [ -z "$ENC_5G" ] && ENC_5G=$(get_qs_val "enc_5g")
    [ -z "$CH_5G" ] && CH_5G=$(get_qs_val "channel_5g")
    [ -z "$HT_5G" ] && HT_5G=$(get_qs_val "htmode_5g")
    [ -z "$HIDDEN_5G" ] && HIDDEN_5G=$(get_qs_val "hidden_5g")

    # If master toggle is explicitly off (0), disable both radios
    if [ "$MASTER_EN" = "0" ]; then
        uci set wireless.radio0.disabled="1" 2>/dev/null || true
        uci set wireless.default_radio0.disabled="1" 2>/dev/null || true
        uci set wireless.radio1.disabled="1" 2>/dev/null || true
        uci set wireless.default_radio1.disabled="1" 2>/dev/null || true
    else
        # 2.4 GHz Configuration
        if [ "$EN_2G" = "0" ]; then
            uci set wireless.radio0.disabled="1" 2>/dev/null || true
            uci set wireless.default_radio0.disabled="1" 2>/dev/null || true
        elif [ "$EN_2G" = "1" ]; then
            uci set wireless.radio0.disabled="0" 2>/dev/null || true
            uci set wireless.default_radio0.disabled="0" 2>/dev/null || true
        fi
        [ -n "$SSID_2G" ] && uci set wireless.default_radio0.ssid="$SSID_2G" 2>/dev/null || true
        if [ "$ENC_2G" = "none" ]; then
            uci set wireless.default_radio0.encryption="none" 2>/dev/null || true
            uci delete wireless.default_radio0.key 2>/dev/null || true
        elif [ -n "$ENC_2G" ]; then
            uci set wireless.default_radio0.encryption="$ENC_2G" 2>/dev/null || true
            [ -n "$KEY_2G" ] && uci set wireless.default_radio0.key="$KEY_2G" 2>/dev/null || true
        elif [ -n "$KEY_2G" ]; then
            uci set wireless.default_radio0.key="$KEY_2G" 2>/dev/null || true
        fi
        [ -n "$CH_2G" ] && uci set wireless.radio0.channel="$CH_2G" 2>/dev/null || true
        [ -n "$HT_2G" ] && uci set wireless.radio0.htmode="$HT_2G" 2>/dev/null || true
        [ -n "$HIDDEN_2G" ] && uci set wireless.default_radio0.hidden="$HIDDEN_2G" 2>/dev/null || true

        # 5 GHz Configuration
        if [ "$EN_5G" = "0" ]; then
            uci set wireless.radio1.disabled="1" 2>/dev/null || true
            uci set wireless.default_radio1.disabled="1" 2>/dev/null || true
        elif [ "$EN_5G" = "1" ]; then
            uci set wireless.radio1.disabled="0" 2>/dev/null || true
            uci set wireless.default_radio1.disabled="0" 2>/dev/null || true
        fi
        [ -n "$SSID_5G" ] && uci set wireless.default_radio1.ssid="$SSID_5G" 2>/dev/null || true
        if [ "$ENC_5G" = "none" ]; then
            uci set wireless.default_radio1.encryption="none" 2>/dev/null || true
            uci delete wireless.default_radio1.key 2>/dev/null || true
        elif [ -n "$ENC_5G" ]; then
            uci set wireless.default_radio1.encryption="$ENC_5G" 2>/dev/null || true
            [ -n "$KEY_5G" ] && uci set wireless.default_radio1.key="$KEY_5G" 2>/dev/null || true
        elif [ -n "$KEY_5G" ]; then
            uci set wireless.default_radio1.key="$KEY_5G" 2>/dev/null || true
        fi
        [ -n "$CH_5G" ] && uci set wireless.radio1.channel="$CH_5G" 2>/dev/null || true
        [ -n "$HT_5G" ] && uci set wireless.radio1.htmode="$HT_5G" 2>/dev/null || true
        [ -n "$HIDDEN_5G" ] && uci set wireless.default_radio1.hidden="$HIDDEN_5G" 2>/dev/null || true
    fi

    uci commit wireless 2>/dev/null || true

    # Non-blocking reload of wireless stack
    ( wifi reload 2>/dev/null || wifi down 2>/dev/null || true ) </dev/null >/dev/null 2>&1 &

    jq -cn '{status: "ok", message: "Wi-Fi settings applied successfully"}'
    exit 0
fi

# 2. READ CURRENT CONFIGURATION & CLIENT STATUS (GET)
R0_DIS=$(uci get wireless.radio0.disabled 2>/dev/null || echo "1")
IF0_DIS=$(uci get wireless.default_radio0.disabled 2>/dev/null || echo "$R0_DIS")
EN_2G=1
[ "$R0_DIS" = "1" ] || [ "$IF0_DIS" = "1" ] && EN_2G=0

SSID_2G=$(uci get wireless.default_radio0.ssid 2>/dev/null || echo "MAXNET")
KEY_2G=$(uci get wireless.default_radio0.key 2>/dev/null || echo "")
ENC_2G=$(uci get wireless.default_radio0.encryption 2>/dev/null || echo "none")
CH_2G=$(uci get wireless.radio0.channel 2>/dev/null || echo "1")
HT_2G=$(uci get wireless.radio0.htmode 2>/dev/null || echo "HE20")
HIDDEN_2G=$(uci get wireless.default_radio0.hidden 2>/dev/null || echo "0")

R1_DIS=$(uci get wireless.radio1.disabled 2>/dev/null || echo "1")
IF1_DIS=$(uci get wireless.default_radio1.disabled 2>/dev/null || echo "$R1_DIS")
EN_5G=1
[ "$R1_DIS" = "1" ] || [ "$IF1_DIS" = "1" ] && EN_5G=0

SSID_5G=$(uci get wireless.default_radio1.ssid 2>/dev/null || echo "MAXNET-5G")
KEY_5G=$(uci get wireless.default_radio1.key 2>/dev/null || echo "")
ENC_5G=$(uci get wireless.default_radio1.encryption 2>/dev/null || echo "none")
CH_5G=$(uci get wireless.radio1.channel 2>/dev/null || echo "36")
HT_5G=$(uci get wireless.radio1.htmode 2>/dev/null || echo "HE80")
HIDDEN_5G=$(uci get wireless.default_radio1.hidden 2>/dev/null || echo "0")

MASTER_EN=0
[ "$EN_2G" -eq 1 ] || [ "$EN_5G" -eq 1 ] && MASTER_EN=1

# Check hardware presence
HW_2G=0
HW_5G=0
[ -d /sys/class/net/wlan0 ] && HW_2G=1
[ -d /sys/class/net/wlan1 ] && HW_5G=1
[ -d /sys/bus/platform/devices/c000000.wifi ] && HW_2G=1
[ -d /sys/bus/pci/devices/0001:01:00.0 ] && HW_5G=1

# Gather connected wireless stations
STATIONS="[]"
if command -v iw >/dev/null 2>&1; then
    TMP_STAS=$(iw dev 2>/dev/null | grep Interface | awk '{print $2}')
    STA_ITEMS=""
    STA_TMP=$(mktemp /tmp/maxnet-wifi-stations.XXXXXX)
    : > "$STA_TMP"
    for wdev in $TMP_STAS; do
        band="2.4 GHz"
        frequency=$(iw dev "$wdev" info 2>/dev/null | awk '/channel/ {for (i=1;i<=NF;i++) if ($i=="MHz") {value=$(i-1); gsub(/[^0-9]/, "", value); print value; exit}}')
        case "$frequency" in ''|*[!0-9]*) frequency=0 ;; esac
        [ "$frequency" -ge 5000 ] 2>/dev/null && band="5 GHz"
        iw dev "$wdev" station dump 2>/dev/null | awk -v band="$band" -v dev="$wdev" '
            /^Station/ {
                if (mac != "") {
                    printf "{\"mac\":\"%s\",\"band\":\"%s\",\"signal\":%d,\"rx_mbps\":%.1f,\"tx_mbps\":%.1f,\"connected\":true,\"blocked\":false},\n", mac, b, sig, rx, tx
                }
                mac = $2; b = band; sig = -65; rx = 0; tx = 0;
            }
            /signal:/ { sig = $2; }
            /rx bitrate:/ { rx = $3; }
            /tx bitrate:/ { tx = $3; }

            END {
                if (mac != "") {
                    printf "{\"mac\":\"%s\",\"band\":\"%s\",\"signal\":%d,\"rx_mbps\":%.1f,\"tx_mbps\":%.1f,\"connected\":true,\"blocked\":false}\n", mac, b, sig, rx, tx
                }
            }
        ' >> "$STA_TMP" 2>/dev/null
    done
    if [ -s "$STA_TMP" ]; then
        STATIONS="["$(sed '$!s/$/,/' "$STA_TMP" | tr '\n' ' ' | sed 's/,[ ]*$/ /')"]"
    fi
    rm -f "$STA_TMP"
fi

BLOCKED_MACS=$(if [ -f /etc/maxnet_wifi_blocked_macs ]; then
    awk 'tolower($0) ~ /^[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]$/ {print tolower($0)}' /etc/maxnet_wifi_blocked_macs | sort -u | jq -Rsc 'split("\n") | map(select(length > 0))'
else
    printf '[]'
fi)
while IFS= read -r blocked_mac; do
    [ -n "$blocked_mac" ] || continue
    set_station_ban "$blocked_mac" 4294967295 >/dev/null 2>&1 || :
done <<EOF_BLOCKED_MACS
$(printf '%s' "$BLOCKED_MACS" | jq -r '.[]' 2>/dev/null)
EOF_BLOCKED_MACS
LEASES='[]'
if [ -r /tmp/dhcp.leases ]; then
    while read -r lease_expiry lease_mac lease_ip lease_name lease_clientid; do
        [ -n "$lease_mac" ] && [ -n "$lease_ip" ] || continue
        LEASES=$(printf '%s' "$LEASES" | jq -c --arg mac "$(printf '%s' "$lease_mac" | tr '[:upper:]' '[:lower:]')" --arg ip "$lease_ip" --arg name "${lease_name:-Wi-Fi station}" '. + [{mac:$mac,ip:$ip,name:$name}]' 2>/dev/null)
    done < /tmp/dhcp.leases
fi
STATIONS=$(jq -cn --argjson stations "$STATIONS" --argjson blocked_macs "${BLOCKED_MACS:-[]}" --argjson leases "$LEASES" '
    ($blocked_macs | map(ascii_downcase)) as $blocked
    | ($stations | map(. as $station | ($leases | map(select(.mac == ($station.mac | ascii_downcase))) | first // {}) as $lease | . + {ip:($lease.ip // ""),name:($lease.name // "Wi-Fi station"),hostname:($lease.name // "Wi-Fi station")} | . + {blocked: ((.mac | ascii_downcase) as $mac | ($blocked | index($mac)) != null)})) as $connected
    | $connected + [$blocked[] as $mac | select(([$connected[].mac | ascii_downcase] | index($mac)) == null) | ($leases | map(select(.mac == $mac)) | first // {}) as $lease | {mac:$mac,ip:($lease.ip // ""),name:($lease.name // "Blocked Wi-Fi station"),hostname:($lease.name // "Blocked Wi-Fi station"),connected:false,blocked:true}]
' 2>/dev/null || printf '[]')

jq -n \
  --argjson master_enabled "$MASTER_EN" \
  --argjson hw_2g "$HW_2G" \
  --argjson hw_5g "$HW_5G" \
  --argjson en_2g "$EN_2G" \
  --arg ssid_2g "$SSID_2G" \
  --arg key_2g "$KEY_2G" \
  --arg enc_2g "$ENC_2G" \
  --arg ch_2g "$CH_2G" \
  --arg ht_2g "$HT_2G" \
  --argjson hidden_2g "${HIDDEN_2G:-0}" \
  --argjson en_5g "$EN_5G" \
  --arg ssid_5g "$SSID_5G" \
  --arg key_5g "$KEY_5G" \
  --arg enc_5g "$ENC_5G" \
  --arg ch_5g "$CH_5G" \
  --arg ht_5g "$HT_5G" \
  --argjson hidden_5g "${HIDDEN_5G:-0}" \
  --argjson clients "$STATIONS" \
  '{
    status: "ok",
    master_enabled: $master_enabled,
    hardware: {
      radio2g: $hw_2g,
      radio5g: $hw_5g,
      soc_wcss: "IPQ9574 2.4GHz",
      pcie_pine: "QCN9074 5GHz"
    },
    radio_2g: {
      enabled: $en_2g,
      ssid: $ssid_2g,
      key: $key_2g,
      encryption: $enc_2g,
      channel: $ch_2g,
      htmode: $ht_2g,
      hidden: $hidden_2g
    },
    radio_5g: {
      enabled: $en_5g,
      ssid: $ssid_5g,
      key: $key_5g,
      encryption: $enc_5g,
      channel: $ch_5g,
      htmode: $ht_5g,
      hidden: $hidden_5g
    },
    clients: $clients
  }'
