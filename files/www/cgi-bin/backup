#!/bin/sh
# Require administrator authentication
. /www/cgi-bin/lib/auth_check.sh 2>/dev/null || . "$(dirname "$0")/lib/auth_check.sh" 2>/dev/null || exit 1
require_auth

echo "Content-Type: application/gzip"
echo "Content-Disposition: attachment; filename=\"maxnet-config-$(date +%Y%m%d-%H%M).tar.gz\""
echo "Cache-Control: no-cache, no-store, must-revalidate"
echo ""

ARCHIVE="/tmp/maxnet_config_backup.tar.gz"
# Exclude /etc/shadow and /etc/passwd to prevent credential leakage
tar -czf "$ARCHIVE" -C / \
    etc/config \
    etc/dropbear \
    etc/nftables.d \
    etc/sysctl.conf \
    etc/rc.local \
    etc/blocked_clients.json \
    etc/tailscale_prefs.json \
    etc/traffic_totals.tsv 2>/dev/null

cat "$ARCHIVE"
rm -f "$ARCHIVE"
