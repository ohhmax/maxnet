#!/bin/sh
# Require administrator authentication
. /www/cgi-bin/lib/auth_check.sh 2>/dev/null || . "$(dirname "$0")/lib/auth_check.sh" 2>/dev/null || exit 1
require_auth

printf "Content-Type: application/json\r\n\r\n"

# Read POST payload safely from standard input
POST_DATA=""
[ "$REQUEST_METHOD" = "POST" ] && [ -n "$CONTENT_LENGTH" ] && POST_DATA=$(head -c "$CONTENT_LENGTH" 2>/dev/null)
[ -z "$POST_DATA" ] && read -r POST_DATA 2>/dev/null

ACTION=$(echo "$POST_DATA" | jq -r '.action // "connect"' 2>/dev/null)
SSID=$(echo "$POST_DATA" | jq -r '.ssid // ""' 2>/dev/null)
KEY=$(echo "$POST_DATA" | jq -r '.key // ""' 2>/dev/null)
ENC=$(echo "$POST_DATA" | jq -r '.encryption // "psk2"' 2>/dev/null)
DEVICE=$(echo "$POST_DATA" | jq -r '.device // "auto"' 2>/dev/null)
BAND=$(echo "$POST_DATA" | jq -r '.band // ""' 2>/dev/null)
CHANNEL=$(echo "$POST_DATA" | jq -r '.channel // ""' 2>/dev/null)
PROTO=$(echo "$POST_DATA" | jq -r '.proto // "dhcp"' 2>/dev/null)
IPADDR=$(echo "$POST_DATA" | jq -r '.ipaddr // ""' 2>/dev/null)
NETMASK=$(echo "$POST_DATA" | jq -r '.netmask // "255.255.255.0"' 2>/dev/null)
GATEWAY=$(echo "$POST_DATA" | jq -r '.gateway // ""' 2>/dev/null)
DNS=$(echo "$POST_DATA" | jq -r '.dns // ""' 2>/dev/null)
MACADDR=$(echo "$POST_DATA" | jq -r '.macaddr // ""' 2>/dev/null)
MTU=$(echo "$POST_DATA" | jq -r '.mtu // ""' 2>/dev/null)
METRIC=$(echo "$POST_DATA" | jq -r '.metric // "20"' 2>/dev/null)
BSSID=$(echo "$POST_DATA" | jq -r '.bssid // ""' 2>/dev/null)
HIDDEN=$(echo "$POST_DATA" | jq -r 'if .hidden == true then "1" else "0" end' 2>/dev/null)

send_error() {
    jq -n --arg msg "$1" '{"status": "error", "message": $msg}'
    exit 0
}

is_valid_ipv4() {
    printf "%s" "$1" | grep -Eq '^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$'
}

is_valid_mac() {
    printf "%s" "$1" | grep -Eq '^([0-9a-fA-F]{2}[:-]){5}([0-9a-fA-F]{2})$'
}

if [ "$ACTION" = "disconnect" ]; then
    uci -q delete wireless.wwan
    uci -q delete network.wwan
    uci -q del_list firewall.@zone[1].network='wwan'
    uci commit wireless
    uci commit network
    uci commit firewall
    /etc/init.d/network reload >/dev/null 2>&1
    /sbin/wifi reload >/dev/null 2>&1
    ( sleep 2; /etc/init.d/firewall reload >/dev/null 2>&1 ) &
    jq -n '{"status": "ok", "message": "Disconnected Wi-Fi WAN"}'
    exit 0
fi

# 1. SSID Validation (1 to 32 bytes)
SSID_LEN=$(printf "%s" "$SSID" | wc -c)
if [ "$SSID_LEN" -lt 1 ] || [ "$SSID_LEN" -gt 32 ]; then
    send_error "SSID must be between 1 and 32 bytes"
fi

# 2. Key Validation (8-63 chars for WPA or 64 hex characters)
if [ -n "$KEY" ]; then
    KEY_LEN=$(printf "%s" "$KEY" | wc -c)
    if [ "$ENC" != "none" ] && { [ "$KEY_LEN" -lt 8 ] || [ "$KEY_LEN" -gt 64 ]; }; then
        send_error "Wi-Fi password must be between 8 and 63 characters (or 64 hex characters)"
    fi
fi

# 3. Protocol Validation
case "$PROTO" in
    dhcp|static) ;;
    *) send_error "Invalid protocol (must be dhcp or static)" ;;
esac

# 4. Static IP / Netmask / Gateway / DNS Validation
if [ "$PROTO" = "static" ]; then
    if [ -z "$IPADDR" ] || [ -z "$GATEWAY" ]; then
        send_error "IP Address and Gateway are required for Static IP mode"
    fi
    is_valid_ipv4 "$IPADDR" || send_error "Invalid IP address format"
    is_valid_ipv4 "$NETMASK" || send_error "Invalid netmask format"
    is_valid_ipv4 "$GATEWAY" || send_error "Invalid gateway IP format"
    if [ -n "$DNS" ]; then
        for dns_ip in $DNS; do
            is_valid_ipv4 "$dns_ip" || send_error "Invalid DNS IP format: $dns_ip"
        done
    fi
fi

# 5. MAC Address and BSSID Validation
if [ -n "$MACADDR" ]; then
    is_valid_mac "$MACADDR" || send_error "Invalid MAC address format"
fi
if [ -n "$BSSID" ]; then
    is_valid_mac "$BSSID" || send_error "Invalid BSSID format"
fi

# 6. Device Validation
if [ "$DEVICE" != "auto" ] && [ -n "$DEVICE" ]; then
    printf "%s" "$DEVICE" | grep -Eq '^radio[0-9]+$' || send_error "Invalid radio device"
fi

# 7. Channel, MTU, Metric Validation
if [ -n "$CHANNEL" ] && [ "$CHANNEL" != "0" ] && [ "$CHANNEL" != "null" ]; then
    printf "%s" "$CHANNEL" | grep -Eq '^[0-9]+$' || send_error "Invalid channel"
fi
if [ -n "$MTU" ]; then
    printf "%s" "$MTU" | grep -Eq '^[0-9]+$' || send_error "Invalid MTU"
    if [ "$MTU" -lt 576 ] || [ "$MTU" -gt 9000 ]; then
        send_error "MTU must be between 576 and 9000"
    fi
fi
if [ -n "$METRIC" ]; then
    printf "%s" "$METRIC" | grep -Eq '^[0-9]+$' || send_error "Invalid metric"
fi

# Auto-resolve target radio device based on band or device parameter
if [ "$DEVICE" = "auto" ] || [ -z "$DEVICE" ]; then
    HAS_RADIO1=$( [ -d /sys/class/ieee80211/phy1 ] && echo "yes" || echo "no" )
    if [ "$HAS_RADIO1" = "yes" ] && { [ "$BAND" = "5GHz" ] || [ "$BAND" = "5g" ]; }; then
        DEVICE="radio1"
    else
        DEVICE="radio0"
    fi
fi

# Configure network interface (DHCP vs Static)
uci set network.wwan=interface
uci set network.wwan.proto="$PROTO"

if [ "$PROTO" = "static" ]; then
    if [ -z "$IPADDR" ] || [ -z "$GATEWAY" ]; then
        cat << JSON_END
{
  "status": "error",
  "message": "IP Address and Gateway are required for Static IP mode"
}
JSON_END
        exit 0
    fi
    uci set network.wwan.ipaddr="$IPADDR"
    uci set network.wwan.netmask="$NETMASK"
    uci set network.wwan.gateway="$GATEWAY"
    [ -n "$DNS" ] && uci set network.wwan.dns="$DNS"
else
    uci delete network.wwan.ipaddr 2>/dev/null
    uci delete network.wwan.netmask 2>/dev/null
    uci delete network.wwan.gateway 2>/dev/null
    uci delete network.wwan.dns 2>/dev/null
fi

[ -n "$MACADDR" ] && uci set network.wwan.macaddr="$MACADDR" || uci delete network.wwan.macaddr 2>/dev/null
[ -n "$MTU" ] && uci set network.wwan.mtu="$MTU" || uci delete network.wwan.mtu 2>/dev/null
uci set network.wwan.metric="${METRIC:-20}"
uci commit network

# Ensure wwan is part of wan firewall zone
if uci get firewall.@zone[1] >/dev/null 2>&1; then
    uci -q del_list firewall.@zone[1].network='wwan'
    uci -q add_list firewall.@zone[1].network='wwan'
    uci commit firewall
fi

# Tune radio device channel to match target if specified
if [ -n "$CHANNEL" ] && [ "$CHANNEL" != "0" ] && [ "$CHANNEL" != "null" ]; then
    uci set wireless."$DEVICE".channel="$CHANNEL"
fi

# Configure wireless sta
uci set wireless.wwan=wifi-iface
uci set wireless.wwan.device="$DEVICE"
uci set wireless.wwan.network="wwan"
uci set wireless.wwan.mode="sta"
uci set wireless.wwan.ssid="$SSID"
uci set wireless.wwan.scan_ssid="$HIDDEN"
if [ -n "$BSSID" ]; then
    uci set wireless.wwan.bssid="$BSSID"
else
    uci -q delete wireless.wwan.bssid
fi

if [ -n "$KEY" ]; then
    case "$ENC" in
        *sae*|*wpa3*)
            uci set wireless.wwan.encryption="sae-mixed"
            ;;
        *mixed*)
            uci set wireless.wwan.encryption="psk-mixed"
            ;;
        *)
            uci set wireless.wwan.encryption="psk2"
            ;;
    esac
    uci set wireless.wwan.key="$KEY"
else
    uci set wireless.wwan.encryption="none"
    uci -q delete wireless.wwan.key
fi

uci commit wireless

/etc/init.d/network reload >/dev/null 2>&1
/sbin/wifi reload >/dev/null 2>&1

# Background probe: ensure STA link brings up fw4 rules automatically
(
    for i in $(seq 1 15); do
        sleep 1
        IFNAME=$(ubus call network.interface.wwan status 2>/dev/null | jq -r '.device // .l3_device // empty' 2>/dev/null)
        if [ -n "$IFNAME" ] && ip link show "$IFNAME" 2>/dev/null | grep -q "UP"; then
            /sbin/ifup wwan >/dev/null 2>&1
            /etc/init.d/firewall reload >/dev/null 2>&1
            break
        fi
    done
) &

jq -n --arg ssid "$SSID" --arg proto "$PROTO" '{
  status: "ok",
  message: ("Connecting to " + $ssid + " as Wi-Fi WAN Uplink (" + $proto + ")")
}'
